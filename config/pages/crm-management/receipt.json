{
  "id": "mgmt-receipt",
  "type": "page",
  "route": "/mgmt/receipts/[receipt_id]",
  "state": {
    "loading": false,
    "initialized": true,
    "filtersVisible": false,
    "receiptData": {
      "id": "",
      "user_id": "",
      "registration_date": "",
      "purchase_date": "",
      "retail_chain_id": "",
      "retail_chain_name": "",
      "promo_products_amount_label": "",
      "total_amount_label": "",
      "fiscal_data": {},
      "receipt_status": "",
      "moderation_status": "",
      "comment": "",
      "moderationStatusLabel": "",
      "moderationStatusSeverity": "",
      "retail_chains": [],
      "statuses": [],
      "fns_status": "",
      "fns_status_label": "",
      "fns_status_severity": "",
      "decline_reason": "",
      "decline_reason_label": "",
      "show_decline_reason": false,
      "receipt_id": "",
      "store_inn_label": "",
      "store_address_label": ""
    },
    "products": {
      "value": [],
      "columns": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0,
      "sortField": "",
      "sortOrder": 1,
      "filters": [],
      "search": ""
    },
    "saveResult": null,
    "saving": false,
    "saved": false,
    "sentSuccessfully": false,
    "participantData": {
      "id": "",
      "full_name": "",
      "email": ""
    }
  },
  "meta": {
    "title": "Чек — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/mgmt/receipts/{$location.routeParams.receipt_id}",
      "method": "GET",
      "target": "state.receiptData"
    },
    {
      "url": "/api/mgmt/receipts/{$location.routeParams.receipt_id}/products",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}",
        "sortField": "{$location.params.sortField}",
        "sortOrder": "{$location.params.sortOrder}",
        "search": "{$location.params.search}",
        "filters": "{$location.params.filters}"
      },
      "method": "GET",
      "target": "state.products"
    },
    {
      "url": "/api/ops/users/{$state.receiptData.user_id}",
      "method": "GET",
      "target": "state.participantData"
    }
  ],
  "shortcuts": {
    "requestProducts": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/mgmt/receipts/{$location.routeParams.receipt_id}/products",
              "method": "GET",
              "target": "state.products",
              "data": {
                "event": "{$event}",
                "first": "{$state.products.first}",
                "rows": "{$state.products.rows}",
                "sortField": "{$state.products.sortField}",
                "sortOrder": "{$state.products.sortOrder}",
                "search": "{$state.products.search}",
                "filters": "{$state.products.filters}"
              },
              "format": {
                "$ref": "../../system/list-request-format.json"
              }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.products.first}",
                "rows": "{$state.products.rows}",
                "sortField": "{$state.products.sortField}",
                "sortOrder": "{$state.products.sortOrder}",
                "search": "{$state.products.search}",
                "filters": "{$state.products.filters}"
              },
              "format": [
                {
                  "prop": "filters",
                  "type": "PopIfHasNullProps",
                  "params": {
                    "props": [
                      "value"
                    ]
                  }
                },
                {
                  "prop": "filters",
                  "type": "RemoveProps",
                  "params": {
                    "props": [
                      "name",
                      "type",
                      "opts"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "deleteReceipt": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.saveResult",
              "value": null
            }
          },
          {
            "type": "confirm",
            "params": {
              "message": "Вы уверены, что хотите удалить этот чек?",
              "onConfirm": [
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/mgmt/receipts/{$location.routeParams.receipt_id}",
                    "method": "DELETE",
                    "target": "state.saveResult",
                    "onSuccess": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "success",
                          "summary": "Успешно",
                          "message": "Чек удален"
                        }
                      },
                      {
                        "type": "navigate",
                        "params": {
                          "url": "/mgmt/receipts"
                        }
                      }
                    ],
                    "onError": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "error",
                          "summary": "Ошибка",
                          "message": "Не удалось удалить чек"
                        }
                      }
                    ]
                  }
                }
              ],
              "onCancel": []
            }
          }
        ]
      }
    },
    "saveReceipt": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.saving",
              "value": true
            }
          },
          {
            "type": "setProperty",
            "params": {
              "target": "state.saveResult",
              "value": null
            }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/mgmt/receipts/{$location.routeParams.receipt_id}",
              "method": "PATCH",
              "target": "state.saveResult",
              "data": {
                "retail_chain_id": "{$state.receiptData.retail_chain_id}",
                "moderation_status": "{$state.receiptData.moderation_status}",
                "comment": "{$state.receiptData.comment}",
                "decline_reason": "{$state.receiptData.decline_reason}"
              },
              "onSuccess": [
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saving",
                    "value": false
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saved",
                    "value": true
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.sentSuccessfully",
                    "value": true
                  }
                }
              ],
              "onError": [
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saving",
                    "value": false
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.sentSuccessfully",
                    "value": false
                  }
                },
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Не удалось сохранить чек"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "autoModerate": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.saveResult",
              "value": null
            }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/mgmt/receipts/{$location.routeParams.receipt_id}/check",
              "method": "POST",
              "target": "state.saveResult",
              "data": {},
              "onSuccess": [
                {
                  "type": "showToast",
                  "params": {
                    "severity": "success",
                    "summary": "Автомодерация",
                    "message": "Проверка выполнена"
                  }
                },
                {
                  "type": "refresh"
                }
              ],
              "onError": [
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Ошибка при проверке"
                  }
                },
                {
                  "type": "refresh"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": {
                  "icon": "pi pi-home",
                  "url": "/"
                },
                "model": [
                  {
                    "label": "Чеки",
                    "route": "/mgmt/receipts"
                  },
                  {
                    "label": "@state.receiptData.receipt_id"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "mainLayout",
      "type": "section",
      "className": "flex mb-5",
      "grid": {
        "cols": [
          "col-12 lg:col-8",
          "col-12 lg:col-4"
        ],
        "padding": "p-2"
      },
      "blocks": [
        {
          "id": "receiptDetailsBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Информация о чеке"
            }
          },
          "className": "flex flex-column gap-3",
          "components": [
            {
              "id": "registrationDateGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата регистрации",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "registrationDate",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.registration_date",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "purchaseDateGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата покупки",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "purchaseDate",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.purchase_date",
                      "dataType": "date",
                      "dateFormat": "DD.MM.YYYY"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptIdGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ID чека (пром.)",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptIdText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.receipt_id"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptModerationStatusGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Статус",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptModerationStatusTag",
                    "type": "component",
                    "componentType": "Tag",
                    "props": {
                      "value": "@state.receiptData.moderationStatusLabel",
                      "severity": "@state.receiptData.moderationStatusSeverity"
                    }
                  }
                ]
              }
            },
            {
              "id": "fnsStatusGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Статус ФНС",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "fnsStatusTag",
                    "type": "component",
                    "componentType": "Tag",
                    "className": "text-sm px-2 py-1",
                    "props": {
                      "value": "@state.receiptData.fns_status_label",
                      "severity": "@state.receiptData.fns_status_severity"
                    }
                  }
                ]
              }
            },
            {
              "id": "storeInnGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ИНН магазина",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "storeInnText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.store_inn_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "storeAddressGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Адрес магазина",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "storeAddressText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.store_address_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "promoAmountGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Сумма акционных продуктов",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "promoAmount",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.promo_products_amount_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "totalAmountGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Сумма общая",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "totalAmount",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.total_amount_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptFnGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФН",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFnText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg wrap-anywhere",
                    "props": {
                      "value": "@state.receiptData.fiscal_data.fiscal_number"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptFdGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФД",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFdText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg wrap-anywhere",
                    "props": {
                      "value": "@state.receiptData.fiscal_data.fiscal_document_number"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptFpGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФП",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFpText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg wrap-anywhere",
                    "props": {
                      "value": "@state.receiptData.fiscal_data.fiscal_sign"
                    }
                  }
                ]
              }
            },
            {
              "id": "declineReasonGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Причина отклонения",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "declineReasonText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.decline_reason_label"
                    }
                  }
                ]
              },
              "visible": "@state.receiptData.show_decline_reason"
            }
          ]
        },
        {
          "id": "rightColumnBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "rightColumnLayout",
              "type": "component",
              "componentType": "LayoutGroup",
              "className": "flex flex-column gap-3",
              "props": {
                "components": [
                  {
                    "id": "participantPanel",
                    "type": "component",
                    "componentType": "Panel",
                    "className": "w-full",
                    "props": {
                      "header": "Участник",
                      "components": [
                        {
                          "id": "participantIdGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "w-full grid align-items-center mb-2",
                          "props": {
                            "label": "ID участника",
                            "labelClassName": "text-sm col-4 text-right",
                            "containerClassName": "col-8",
                            "components": [
                              {
                                "id": "participantIdText",
                                "type": "component",
                                "componentType": "Text",
                                "className": "m-0",
                                "style": {
                                  "wordBreak": "break-all"
                                },
                                "props": {
                                  "value": "@state.receiptData.user_id"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "id": "participantNameGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "w-full grid align-items-center mb-2",
                          "props": {
                            "label": "Имя",
                            "labelClassName": "text-sm col-4 text-right",
                            "containerClassName": "col-8",
                            "components": [
                              {
                                "id": "participantNameText",
                                "type": "component",
                                "componentType": "Text",
                                "className": "m-0 font-semibold",
                                "props": {
                                  "value": "@state.participantData.full_name"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "id": "participantEmailGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "w-full grid align-items-center mb-2",
                          "props": {
                            "label": "E-mail",
                            "labelClassName": "text-sm col-4 text-right",
                            "containerClassName": "col-8",
                            "components": [
                              {
                                "id": "participantEmailText",
                                "type": "component",
                                "componentType": "Text",
                                "className": "m-0",
                                "props": {
                                  "value": "@state.participantData.email"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "id": "participantGoButton",
                          "type": "component",
                          "componentType": "Button",
                          "className": "mt-2",
                          "props": {
                            "label": "Перейти",
                            "icon": "pi pi-arrow-right",
                            "iconPos": "right",
                            "severity": "secondary",
                            "outlined": true,
                            "size": "small"
                          },
                          "events": [
                            {
                              "type": "onClick",
                              "commands": [
                                {
                                  "type": "navigate",
                                  "params": {
                                    "url": "/ops/users/{@state.receiptData.user_id}"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "id": "moderationPanel",
                    "type": "component",
                    "componentType": "Panel",
                    "className": "w-full",
                    "props": {
                      "header": "Модерация",
                      "className": "w-full",
                      "components": [
                        {
                          "id": "retailChainGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "flex flex-column gap-1 mb-2",
                          "props": {
                            "label": "Торговая сеть",
                            "labelClassName": "font-bold text-sm",
                            "components": [
                              {
                                "id": "retailChainDropdown",
                                "type": "component",
                                "componentType": "Dropdown",
                                "props": {
                                  "options": "@state.receiptData.retail_chains",
                                  "value": "@state.receiptData.retail_chain_id",
                                  "optionLabel": "name",
                                  "optionValue": "id",
                                  "placeholder": "Выберите торговую сеть",
                                  "className": "w-full"
                                },
                                "events": [
                                  {
                                    "type": "onChange",
                                    "commands": [
                                      {
                                        "type": "setProperty",
                                        "params": {
                                          "source": "event.value",
                                          "target": "state.receiptData.retail_chain_id"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "id": "moderationStatusGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "flex flex-column gap-1 mb-2",
                          "props": {
                            "label": "Статус модерации",
                            "labelClassName": "font-bold text-sm",
                            "components": [
                              {
                                "id": "moderationStatusDropdown",
                                "type": "component",
                                "componentType": "Dropdown",
                                "props": {
                                  "options": "@state.receiptData.moderation_statuses",
                                  "value": "@state.receiptData.moderation_status",
                                  "optionLabel": "name",
                                  "optionValue": "id",
                                  "placeholder": "Выберите статус",
                                  "className": "w-full"
                                },
                                "events": [
                                  {
                                    "type": "onChange",
                                    "commands": [
                                      {
                                        "type": "setProperty",
                                        "params": {
                                          "source": "event.value",
                                          "target": "state.receiptData.moderation_status"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "id": "declineReasonEditGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "w-full grid align-items-center mb-2",
                          "props": {
                            "label": "Причина отклонения",
                            "labelClassName": "text-sm col-4 text-right",
                            "containerClassName": "col-8",
                            "components": [
                              {
                                "id": "declineReasonDropdown",
                                "type": "component",
                                "componentType": "Dropdown",
                                "props": {
                                  "options": "@state.receiptData.decline_reasons",
                                  "value": "@state.receiptData.decline_reason",
                                  "optionLabel": "name",
                                  "optionValue": "id",
                                  "placeholder": "Выберите причину",
                                  "className": "w-full"
                                },
                                "events": [
                                  {
                                    "type": "onChange",
                                    "commands": [
                                      {
                                        "type": "setProperty",
                                        "params": {
                                          "source": "event.value",
                                          "target": "state.receiptData.decline_reason"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          "visible": "@state.receiptData.show_decline_reason"
                        },
                        {
                          "id": "commentGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "flex flex-column gap-1 mb-2",
                          "props": {
                            "label": "Комментарий",
                            "labelClassName": "font-bold text-sm",
                            "components": [
                              {
                                "id": "commentInput",
                                "type": "component",
                                "componentType": "InputTextarea",
                                "props": {
                                  "value": "@state.receiptData.comment",
                                  "rows": 3,
                                  "autoResize": true,
                                  "className": "w-full"
                                },
                                "events": [
                                  {
                                    "type": "onChange",
                                    "commands": [
                                      {
                                        "type": "setProperty",
                                        "params": {
                                          "source": "event.value",
                                          "target": "state.receiptData.comment"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "id": "btnAutoModerate",
                          "type": "component",
                          "componentType": "Button",
                          "props": {
                            "label": "Автомодерация",
                            "icon": "pi pi-search",
                            "severity": "info",
                            "outlined": true
                          },
                          "events": [
                            {
                              "type": "onClick",
                              "commands": [
                                "autoModerate"
                              ]
                            }
                          ]
                        },
                        {
                          "id": "btnApply",
                          "type": "component",
                          "componentType": "Button",
                          "props": {
                            "label": "Применить",
                            "icon": "pi pi-check",
                            "severity": "success",
                            "outlined": true,
                            "disabled": "@state.saving"
                          },
                          "events": [
                            {
                              "type": "onClick",
                              "commands": [
                                "saveReceipt",
                                {
                                  "type": "showToast",
                                  "params": {
                                    "severity": "success",
                                    "summary": "Успешно",
                                    "message": "Чек сохранен",
                                    "condition": "{$state.sentSuccessfully}"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "productsFilters",
      "type": "section",
      "className": "flex flex-column gap-3 mb-3",
      "blocks": [
        {
          "id": "productsSearchBlock",
          "type": "block",
          "className": "w-full flex gap-3",
          "components": [
            {
              "id": "productsSearchInput",
              "type": "component",
              "className": "w-full p-inputtext-sm mb-0",
              "componentType": "InputTextWithThrottle",
              "props": {
                "placeholder": "Быстрый поиск...",
                "throttleDelay": 500,
                "value": "@state.products.search"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.products.search"
                      }
                    },
                    "requestProducts"
                  ]
                }
              ]
            },
            {
              "id": "productsToggleFilters",
              "type": "component",
              "componentType": "Button",
              "className": "min-w-max flex-grow-0 px-3",
              "props": {
                "icon": "pi pi-filter",
                "severity": "primary",
                "outlined": true,
                "size": "small",
                "label": "Фильтры"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "productsActiveFilterBlock",
          "type": "block",
          "wrapper": {
            "className": "w-full"
          },
          "components": [
            {
              "id": "productsActiveFilterChips",
              "type": "component",
              "componentType": "ActiveFiltersBar",
              "props": {
                "value": "@state.products.filters"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.products.filters"
                      }
                    },
                    "requestProducts"
                  ]
                }
              ]
            },
            {
              "id": "productsFilterDrawer",
              "type": "component",
              "componentType": "FiltersPanel",
              "props": {
                "value": "@state.products.filters",
                "visible": "@state.filtersVisible",
                "position": "right",
                "header": "Фильтры"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.products.filters"
                      }
                    },
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    },
                    "requestProducts"
                  ]
                },
                {
                  "type": "onHide",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "productsTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "productsTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "productsTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.products.value",
                "columns": "@state.products.columns",
                "totalRecords": "@state.products.totalRecords",
                "rows": "@state.products.rows",
                "first": "@state.products.first",
                "sortField": "@state.products.sortField",
                "sortOrder": "@state.products.sortOrder",
                "paginator": true,
                "lazy": true,
                "size": "small",
                "rowsPerPageOptions": [
                  5,
                  10,
                  25,
                  50
                ],
                "customColumns": [
                  {
                    "field": "is_promo",
                    "body": [
                      {
                        "componentType": "Button",
                        "className": "pointer-events-none -m-2",
                        "props": {
                          "icon": "{#row.is_promo_icon}",
                          "severity": "{#row.is_promo_severity}",
                          "text": true,
                          "rounded": true,
                          "size": "large"
                        }
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": [
                    "requestProducts"
                  ]
                },
                {
                  "type": "onSort",
                  "commands": [
                    "requestProducts"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "buttonsSection",
      "type": "section",
      "className": "flex justify-content-center",
      "blocks": [
        {
          "id": "buttonsBlock",
          "type": "block",
          "wrapper": {
            "showHeader": false,
            "component": "Panel",
            "props": {
              "className": "flex-grow-1",
              "pt": {
                "content": {
                  "style": {
                    "background": "var(--surface-50) !important"
                  }
                }
              }
            }
          },
          "className": "flex flex-wrap gap-3 justify-content-center md:justify-content-start",
          "components": [
            {
              "id": "btnDelete",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-trash",
                "label": "Удалить",
                "size": "small",
                "severity": "danger",
                "outlined": true
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    "deleteReceipt"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
