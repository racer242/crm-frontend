{
  "id": "user-docs",
  "type": "page",
  "route": "/ops/users/[user_id]/docs",
  "state": {
    "loading": false,
    "initialized": true,
    "docsData": {}
  },
  "meta": {
    "title": "Документы участника — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}",
      "method": "GET",
      "target": "state.docsData",
      "adapter": "user-docs.response"
    }
  ],
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": { "icon": "pi pi-home", "url": "/" },
                "model": [
                  { "label": "Участники", "route": "/ops/users" },
                  {
                    "label": "@state.docsData.fullName",
                    "route": "/ops/users/{@state.docsData.id}"
                  },
                  { "label": "Документы" }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "docs",
                "activeSubitemId": "personal-docs",
                "pt": { "menu": { "className": "gap-1" } },
                "$ref": "../menus/user.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "docsLayout",
      "type": "section",
      "className": "flex",
      "grid": {
        "cols": ["col-12 lg:col-6", "col-12 lg:col-6"],
        "padding": "p-2"
      },
      "blocks": [
        {
          "id": "passportBlock",
          "type": "block",
          "className": "",
          "components": [
            {
              "id": "passportPanel",
              "type": "component",
              "componentType": "Panel",
              "className": "mb-4",
              "props": {
                "header": "Паспорт",
                "containerClassName": "flex flex-column gap-3",
                "components": [
                  {
                    "id": "passportLastNameGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "w-full grid align-items-center mb-2",
                    "props": {
                      "label": "Фамилия",
                      "labelClassName": "text-sm col-4 text-right",
                      "containerClassName": "col-8",
                      "components": [
                        {
                          "id": "passportLastName",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 font-bold text-lg",
                          "props": {
                            "value": "@state.docsData.passport_last_name"
                          },
                          "state": {}
                        }
                      ]
                    }
                  },
                  {
                    "id": "passportFirstNameGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "w-full grid align-items-center mb-2",
                    "props": {
                      "label": "Имя",
                      "labelClassName": "text-sm col-4 text-right",
                      "containerClassName": "col-8",
                      "components": [
                        {
                          "id": "passportFirstName",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 font-bold text-lg",
                          "props": {
                            "value": "@state.docsData.passport_first_name"
                          },
                          "state": {}
                        }
                      ]
                    }
                  },
                  {
                    "id": "passportMiddleNameGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "w-full grid align-items-center mb-2",
                    "props": {
                      "label": "Отчество",
                      "labelClassName": "text-sm col-4 text-right",
                      "containerClassName": "col-8",
                      "components": [
                        {
                          "id": "passportMiddleName",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 font-bold text-lg",
                          "props": {
                            "value": "@state.docsData.passport_middle_name"
                          },
                          "state": {}
                        }
                      ]
                    }
                  },
                  {
                    "id": "passportSeriesNumberGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "w-full grid align-items-center mb-2",
                    "props": {
                      "label": "Серия и номер паспорта",
                      "labelClassName": "text-sm col-4 text-right",
                      "containerClassName": "col-8",
                      "components": [
                        {
                          "id": "passportSeriesNumber",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 font-bold text-lg",
                          "props": {
                            "value": "@state.docsData.passport_series_number"
                          },
                          "state": {}
                        }
                      ]
                    }
                  },
                  {
                    "id": "passportIssuedByGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "w-full grid align-items-start mb-2",
                    "props": {
                      "label": "Кем выдан",
                      "labelClassName": "text-sm col-4 text-right",
                      "containerClassName": "col-8",
                      "components": [
                        {
                          "id": "passportIssuedBy",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 font-bold text-lg",
                          "props": {
                            "value": "@state.docsData.passport_issued_by"
                          },
                          "state": {}
                        }
                      ]
                    }
                  },
                  {
                    "id": "passportIssueDateGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "w-full grid align-items-center mb-2",
                    "props": {
                      "label": "Дата выдачи паспорта",
                      "labelClassName": "text-sm col-4 text-right",
                      "containerClassName": "col-8",
                      "components": [
                        {
                          "id": "passportIssueDate",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 font-bold text-lg",
                          "props": {
                            "value": "@state.docsData.passport_issue_date_formatted"
                          },
                          "state": {}
                        }
                      ]
                    }
                  },
                  {
                    "id": "passportRegistrationAddressGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "w-full grid align-items-start mb-2",
                    "props": {
                      "label": "Адрес регистрации",
                      "labelClassName": "text-sm col-4 text-right",
                      "containerClassName": "col-8",
                      "components": [
                        {
                          "id": "passportRegistrationAddress",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 font-bold text-lg",
                          "props": {
                            "value": "@state.docsData.passport_registration_address"
                          },
                          "state": {}
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "rightColumnBlock",
          "type": "block",
          "className": "flex flex-column",
          "components": [
            {
              "id": "innPanel",
              "type": "component",
              "componentType": "Panel",
              "className": "mb-4",
              "props": {
                "header": "ИНН",
                "containerClassName": "flex flex-column gap-3",
                "components": [
                  {
                    "id": "innNumberGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "w-full grid align-items-center mb-2",
                    "props": {
                      "label": "Номер ИНН",
                      "labelClassName": "text-sm col-4 text-right",
                      "containerClassName": "col-8",
                      "components": [
                        {
                          "id": "innNumber",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 font-bold text-lg",
                          "props": {
                            "value": "@state.docsData.inn"
                          },
                          "state": {}
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "buttonsSection",
      "type": "section",
      "className": "flex justify-content-center",
      "blocks": [
        {
          "id": "buttonsBlock",
          "type": "block",
          "wrapper": {
            "showHeader": false,
            "component": "Panel",
            "props": {
              "className": "flex-grow-1",
              "pt": {
                "content": {
                  "style": { "background": "var(--surface-50) !important" }
                }
              }
            }
          },
          "className": "flex flex-wrap gap-3 justify-content-center md:justify-content-start",
          "components": [
            {
              "id": "btnEditDocs",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-pencil",
                "label": "Редактировать",
                "size": "small",
                "severity": "info"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/docs/edit"
                      }
                    }
                  ]
                }
              ],
              "state": {}
            }
          ]
        }
      ]
    }
  ]
}
