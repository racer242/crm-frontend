{
  "id": "user-act",
  "type": "page",
  "route": "/ops/users/[user_id]/acts/[act_id]",
  "state": {
    "loading": false,
    "initialized": true,
    "saveResult": null,
    "userData": {
      "id": "",
      "full_name": "",
      "email": ""
    },
    "actData": {
      "id": "",
      "user_id": "",
      "prize_id": "",
      "status": "",
      "status_label": "",
      "status_severity": "",
      "file_url": "",
      "created_at": "",
      "updated_at": ""
    }
  },
  "meta": {
    "title": "Акт участника — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}",
      "method": "GET",
      "target": "state.userData"
    },
    {
      "url": "/api/ops/acts/{$location.routeParams.act_id}",
      "method": "GET",
      "target": "state.actData"
    }
  ],
  "shortcuts": {
    "deleteAct": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.saveResult",
              "value": null
            }
          },
          {
            "type": "confirm",
            "params": {
              "message": "Вы уверены, что хотите удалить этот акт?",
              "onConfirm": [
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/ops/acts/{$location.routeParams.act_id}",
                    "method": "DELETE",
                    "target": "state.saveResult",
                    "onSuccess": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "success",
                          "summary": "Успешно",
                          "message": "Акт удален"
                        }
                      },
                      {
                        "type": "navigate",
                        "params": {
                          "url": "/ops/users/{$location.routeParams.user_id}/acts"
                        }
                      }
                    ],
                    "onError": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "error",
                          "summary": "Ошибка",
                          "message": "Не удалось удалить акт"
                        }
                      }
                    ]
                  }
                }
              ],
              "onCancel": []
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": { "icon": "pi pi-home", "url": "/" },
                "model": [
                  { "label": "Участники", "route": "/ops/users" },
                  {
                    "label": "@state.userData.full_name",
                    "route": "/ops/users/{@state.userData.id}"
                  },
                  {
                    "label": "Акты",
                    "route": "/ops/users/{@state.userData.id}/acts"
                  },
                  { "label": "@state.actData.id" }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "docs",
                "activeSubitemId": "acts",
                "pt": { "menu": { "className": "gap-1" } },
                "$ref": "../menus/user.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "mainLayout",
      "type": "section",
      "className": "flex mb-5",
      "grid": {
        "cols": ["col-12 lg:col-8", "col-12 lg:col-4"],
        "padding": "p-2"
      },
      "blocks": [
        {
          "id": "actDetailsBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Информация об акте"
            }
          },
          "className": "flex flex-column gap-3",
          "components": [
            {
              "id": "userNameGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Участник",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "userNameLink",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg text-primary",
                    "props": {
                      "value": "@state.userData.full_name"
                    },
                    "events": [
                      {
                        "type": "onClick",
                        "commands": [
                          {
                            "type": "navigate",
                            "params": {
                              "url": "/ops/users/{@state.actData.user_id}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": "userEmailGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Email",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "userEmailLink",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg text-primary",
                    "style": { "wordBreak": "break-all" },
                    "props": {
                      "value": "@state.userData.email"
                    }
                  }
                ]
              }
            },
            {
              "id": "statusGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Статус",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "statusTag",
                    "type": "component",
                    "componentType": "Tag",
                    "className": "text-sm px-2 py-1",
                    "props": {
                      "value": "@state.actData.status_label",
                      "severity": "@state.actData.status_severity"
                    }
                  }
                ]
              }
            },
            {
              "id": "createdAtGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата создания",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "createdAtText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.actData.created_at"
                    }
                  }
                ]
              }
            },
            {
              "id": "updatedAtGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Обновлён",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "updatedAtText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.actData.updated_at"
                    }
                  }
                ]
              }
            },
            {
              "id": "documentBlankGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Бланк документа",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "documentBlankLink",
                    "type": "component",
                    "componentType": "Button",
                    "props": {
                      "label": "Скачать",
                      "icon": "pi pi-download",
                      "size": "small",
                      "severity": "info",
                      "outlined": true
                    },
                    "events": [
                      {
                        "type": "onClick",
                        "commands": [
                          {
                            "type": "log",
                            "params": {
                              "message": "Download {$state.actData.file_url}",
                              "condition": "{$state.actData.file_url}"
                            }
                          },
                          {
                            "type": "showToast",
                            "params": {
                              "severity": "warn",
                              "summary": "Бланк отсутствует",
                              "message": "Бланк документа для данного акта не загружен",
                              "condition": {
                                "value": "{$state.actData.file_url}",
                                "not": true
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "prizeBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Приз"
            }
          },
          "className": "flex flex-column gap-3",
          "components": [
            {
              "id": "prizeIdGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ID приза",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "prizeIdText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": { "wordBreak": "break-all" },
                    "props": {
                      "value": "@state.actData.prize_id"
                    }
                  }
                ]
              }
            },
            {
              "id": "prizeLinkBtn",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-gift",
                "label": "Перейти к призу",
                "size": "small",
                "severity": "info",
                "outlined": true,
                "className": "w-full"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/prizes/{$state.actData.prize_id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "buttonsSection",
      "type": "section",
      "className": "flex justify-content-center",
      "blocks": [
        {
          "id": "buttonsBlock",
          "type": "block",
          "wrapper": {
            "showHeader": false,
            "component": "Panel",
            "props": {
              "className": "flex-grow-1",
              "pt": {
                "content": {
                  "style": { "background": "var(--surface-50) !important" }
                }
              }
            }
          },
          "className": "flex flex-wrap gap-3 justify-content-center md:justify-content-start",
          "components": [
            {
              "id": "btnEdit",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-pencil",
                "label": "Редактировать",
                "size": "small",
                "severity": "info"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/acts/{$location.routeParams.act_id}/edit"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "btnDelete",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-trash",
                "label": "Удалить",
                "size": "small",
                "severity": "danger",
                "outlined": true
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": ["deleteAct"]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
