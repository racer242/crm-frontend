{
  "id": "messages",
  "type": "page",
  "route": "/ops/messages",
  "state": {
    "loading": false,
    "initialized": true,
    "messages": {
      "value": [],
      "columns": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    },
    "messagesDialog": {},
    "messagesDialogVisible": false
  },
  "meta": {
    "title": "Сообщения — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/messages",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}"
      },
      "method": "GET",
      "target": "state.messages"
    }
  ],
  "shortcuts": {
    "requestMessages": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/messages",
              "method": "GET",
              "target": "state.messages",
              "data": {
                "event": "{$event}",
                "first": "{$state.messages.first}",
                "rows": "{$state.messages.rows}"
              },
              "format": { "$ref": "../system/list-request-format.json" }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.messages.first}",
                "rows": "{$state.messages.rows}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": { "icon": "pi pi-home", "url": "/" },
                "model": [{ "label": "Сообщения" }]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "messagesHeader",
      "type": "section",
      "className": "flex align-items-center justify-content-between",
      "blocks": [
        {
          "id": "messagesTitle",
          "type": "block",
          "components": [
            {
              "id": "messagesPageTitle",
              "type": "component",
              "componentType": "Text",
              "props": {
                "value": "Сообщения",
                "level": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "messagesTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "messagesTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "messagesTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.messages.value",
                "columns": "@state.messages.columns",
                "totalRecords": "@state.messages.totalRecords",
                "rows": "@state.messages.rows",
                "first": "@state.messages.first",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [5, 10, 25, 50]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": ["requestMessages"]
                },
                {
                  "type": "onSort",
                  "commands": ["requestMessages"]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.data",
                        "target": "state.messagesDialog"
                      }
                    },
                    {
                      "type": "setProperty",
                      "params": {
                        "target": "state.messagesDialogVisible",
                        "value": true
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "messageDialogSection",
      "type": "section",
      "blocks": [
        {
          "id": "messageDialogBlock",
          "type": "block",
          "components": [
            {
              "id": "messageDialog",
              "type": "component",
              "componentType": "Dialog",
              "props": {
                "header": "@state.messagesDialog.message_id",
                "visible": "@state.messagesDialogVisible",
                "modal": true,
                "closable": true,
                "draggable": false,
                "resizable": false,
                "style": { "width": "560px" },
                "containerClassName": "flex flex-column gap-3",
                "components": [
                  {
                    "id": "messageDialogSender",
                    "type": "component",
                    "componentType": "LayoutGroup",
                    "className": "flex align-items-center gap-3",
                    "props": {
                      "components": [
                        {
                          "id": "messageDialogAvatar",
                          "type": "component",
                          "componentType": "Avatar",
                          "props": {
                            "initials": "@state.messagesDialog.sender_name",
                            "icon": "pi pi-user",
                            "shape": "circle",
                            "size": "large"
                          },
                          "style": {
                            "backgroundColor": "#eef3fb",
                            "color": "#2c62b6",
                            "fontWeight": "600"
                          }
                        },
                        {
                          "id": "messageDialogSenderInfo",
                          "type": "component",
                          "componentType": "LayoutGroup",
                          "className": "flex flex-column",
                          "props": {
                            "components": [
                              {
                                "id": "messageDialogSenderName",
                                "type": "component",
                                "componentType": "Text",
                                "className": "m-0 font-semibold",
                                "props": {
                                  "value": "@state.messagesDialog.sender_name_label"
                                }
                              },
                              {
                                "id": "messageDialogSenderEmail",
                                "type": "component",
                                "componentType": "Text",
                                "className": "m-0 text-sm text-500",
                                "props": {
                                  "value": "@state.messagesDialog.sender_email_label"
                                }
                              }
                            ]
                          }
                        },
                        {
                          "id": "messageDialogDateStatus",
                          "type": "component",
                          "componentType": "LayoutGroup",
                          "className": "flex flex-column align-items-end gap-1 ml-auto",
                          "props": {
                            "components": [
                              {
                                "id": "messageDialogDate",
                                "type": "component",
                                "componentType": "Text",
                                "className": "m-0 text-sm text-500",
                                "props": {
                                  "value": "@state.messagesDialog.created_at_formatted"
                                }
                              },
                              {
                                "id": "messageDialogStatusTag",
                                "type": "component",
                                "componentType": "Tag",
                                "props": {
                                  "value": "@state.messagesDialog.status_label",
                                  "severity": "@state.messagesDialog.status_severity"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "messageDialogDivider1",
                    "type": "component",
                    "componentType": "Divider",
                    "className": "my-1",
                    "props": { "type": "solid" }
                  },
                  {
                    "id": "messageDialogSubjectLabel",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "props": {
                      "label": "Тема обращения",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "messageDialogSubject",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.messagesDialog.subject_label"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "messageDialogMessageLabel",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "props": {
                      "label": "Сообщение",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "messageDialogText",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 white-space-pre-wrap",
                          "props": {
                            "value": "@state.messagesDialog.message"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "messageDialogActions",
                    "type": "component",
                    "componentType": "LayoutGroup",
                    "className": "flex gap-2 justify-content-end mt-1",
                    "props": {
                      "components": [
                        {
                          "id": "messageDialogWriteButton",
                          "type": "component",
                          "componentType": "Button",
                          "props": {
                            "label": "Написать письмо",
                            "icon": "pi pi-envelope",
                            "severity": "success",
                            "size": "small",
                            "disabled": "@state.messagesDialog.mailto_disabled"
                          },
                          "events": [
                            {
                              "type": "onClick",
                              "commands": [
                                {
                                  "type": "navigate",
                                  "params": {
                                    "url": "{$state.messagesDialog.mailto_link}"
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "messageDialogCloseButton",
                          "type": "component",
                          "componentType": "Button",
                          "props": {
                            "label": "Закрыть",
                            "icon": "pi pi-times",
                            "severity": "secondary",
                            "outlined": true,
                            "size": "small"
                          },
                          "events": [
                            {
                              "type": "onClick",
                              "commands": [
                                {
                                  "type": "setProperty",
                                  "params": {
                                    "target": "state.messagesDialogVisible",
                                    "value": false
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              },
              "events": [
                {
                  "type": "onHide",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "target": "state.messagesDialogVisible",
                        "value": false
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}