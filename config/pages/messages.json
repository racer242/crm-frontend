{
  "id": "opsMessagesPage",
  "type": "page",
  "title": "Обратная связь",
  "route": "/ops/messages",
  "state": { "items": [] },
  "sections": [
    {
      "id": "content",
      "dataFeed": [{ "method": "GET", "url": "/api/ops/messages", "target": "state.items", "adapter": "extractPaginationItems" }],
      "blocks": [
        {
          "id": "b1",
          "components": [
            {
              "type": "DataTable",
              "value": "@opsMessagesPage.state.items",
              "columns": [
                { "field": "id", "header": "ID" },
                { "field": "user_id", "header": "Участник" },
                { "field": "message", "header": "Сообщение" },
                { "field": "created_at", "header": "Дата" }
              ]
            }
          ]
        }
      ]
    }
  ]
}