{
  "id": "messages",
  "type": "page",
  "route": "/ops/messages",
  "state": {
    "loading": false,
    "initialized": true,
    "messages": {
      "value": [],
      "columns": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    },
    "messagesDialog": {
      "visible": false,
      "subject": "",
      "text": ""
    }
  },
  "meta": {
    "title": "Сообщения — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/messages",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}"
      },
      "method": "GET",
      "target": "state.messages"
    }
  ],
  "shortcuts": {
    "requestMessages": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/messages",
              "method": "GET",
              "target": "state.messages",
              "data": {
                "event": "{$event}",
                "first": "{$state.messages.first}",
                "rows": "{$state.messages.rows}"
              },
              "format": { "$ref": "../system/list-request-format.json" }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.messages.first}",
                "rows": "{$state.messages.rows}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": { "icon": "pi pi-home", "url": "/" },
                "model": [{ "label": "Сообщения" }]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "messagesHeader",
      "type": "section",
      "className": "flex align-items-center justify-content-between",
      "blocks": [
        {
          "id": "messagesTitle",
          "type": "block",
          "components": [
            {
              "id": "messagesPageTitle",
              "type": "component",
              "componentType": "Text",
              "props": {
                "value": "Сообщения",
                "level": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "messagesTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "messagesTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "messagesTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.messages.value",
                "columns": "@state.messages.columns",
                "totalRecords": "@state.messages.totalRecords",
                "rows": "@state.messages.rows",
                "first": "@state.messages.first",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "rowsPerPageOptions": [5, 10, 25, 50]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": ["requestMessages"]
                },
                {
                  "type": "onSort",
                  "commands": ["requestMessages"]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "target": "state.messagesDialog.subject",
                        "value": "{$event.data.subject}"
                      }
                    },
                    {
                      "type": "setProperty",
                      "params": {
                        "target": "state.messagesDialog.text",
                        "value": "{$event.data.message}"
                      }
                    },
                    {
                      "type": "setProperty",
                      "params": {
                        "target": "state.messagesDialog.visible",
                        "value": true
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "messageDialogSection",
      "type": "section",
      "blocks": [
        {
          "id": "messageDialogBlock",
          "type": "block",
          "components": [
            {
              "id": "messageDialog",
              "type": "component",
              "componentType": "Dialog",
              "props": {
                "header": "@state.messagesDialog.subject",
                "visible": "@state.messagesDialog.visible",
                "modal": true,
                "closable": true,
                "draggable": false,
                "resizable": false,
                "style": { "width": "560px" },
                "components": [
                  {
                    "id": "messageDialogText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 white-space-pre-wrap",
                    "props": {
                      "value": "@state.messagesDialog.text"
                    }
                  }
                ]
              },
              "events": [
                {
                  "type": "onHide",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "target": "state.messagesDialog.visible",
                        "value": false
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}