{
  "id": "raffle-edit",
  "type": "page",
  "route": "/ops/raffles/[raffle_id]/edit",
  "state": {
    "loading": false,
    "saving": false,
    "saved": false,
    "sentSuccessfully": false,
    "saveResult": null,
    "raffleData": {
      "id": "",
      "name": "",
      "name_label": "",
      "type": "",
      "type_label": "",
      "status": "",
      "status_label": "",
      "status_severity": "secondary",
      "collection_from": "",
      "collection_to": "",
      "collection_from_label": "—",
      "collection_to_label": "—",
      "collection_period_label": "—",
      "source_types": [],
      "source_types_label": "—",
      "start_at": "",
      "start_at_label": "—",
      "end_at": "",
      "end_at_label": "—",
      "publish_at": "",
      "publish_at_label": "—",
      "drawn_at": "",
      "drawn_at_label": "—",
      "is_published": false,
      "published_label": "Нет",
      "is_editable": false,
      "edit_disabled": true,
      "is_stale": false,
      "is_stale_label": "Нет",
      "created_at": "",
      "created_at_label": "—",
      "updated_at": "",
      "updated_at_label": "—",
      "booked_chances": "",
      "booked_chances_label": "—",
      "annul_reason": "",
      "annul_reason_label": "—"
    },
    "chanceSourceTypes": [
      { "label": "Чек", "value": "receipt" },
      { "label": "Промокод", "value": "promo_code" },
      { "label": "Код GTIN", "value": "gtin_code" },
      { "label": "Победа в игре", "value": "game_win" },
      { "label": "Покупка за баллы", "value": "points_purchase" },
      { "label": "Вручную", "value": "manual" }
    ]
  },
  "meta": {
    "title": "Редактирование розыгрыша — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/raffles/{$location.routeParams.raffle_id}",
      "method": "GET",
      "target": "state.raffleData"
    }
  ],
  "shortcuts": {
    "saveRaffle": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.saving",
              "value": true
            }
          },
          {
            "type": "setProperty",
            "params": {
              "target": "state.saveResult",
              "value": null
            }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/raffles/{$location.routeParams.raffle_id}",
              "method": "PATCH",
              "target": "state.saveResult",
              "data": {
                "name": "{$state.raffleData.name}",
                "type": "{$state.raffleData.type}",
                "source_types": "{$state.raffleData.source_types}",
                "publish_at": "{$state.raffleData.publish_at}",
                "collection_from": "{$state.raffleData.collection_from}",
                "collection_to": "{$state.raffleData.collection_to}"
              },
              "onSuccess": [
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saving",
                    "value": false
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saved",
                    "value": true
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.sentSuccessfully",
                    "value": true
                  }
                }
              ],
              "onError": [
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saving",
                    "value": false
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.sentSuccessfully",
                    "value": false
                  }
                },
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Не удалось сохранить розыгрыш"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": {
                  "icon": "pi pi-home",
                  "url": "/"
                },
                "model": [
                  {
                    "label": "Розыгрыши",
                    "route": "/ops/raffles"
                  },
                  {
                    "label": "@state.raffleData.name_label",
                    "route": "/ops/raffles/{@state.raffleData.id}"
                  },
                  {
                    "label": "Редактирование"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "formMainSection",
      "type": "section",
      "className": "",
      "grid": {
        "cols": [
          "col-12 lg:col-6",
          "col-12 lg:col-6"
        ],
        "padding": "p-2"
      },
      "blocks": [
        {
          "id": "paramBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Параметры розыгрыша"
            }
          },
          "className": "flex flex-column",
          "components": [
            {
              "id": "editNameGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "flex flex-column gap-1 mb-2",
              "props": {
                "label": "Название",
                "labelClassName": "font-bold text-sm",
                "components": [
                  {
                    "id": "nameInput",
                    "type": "component",
                    "componentType": "InputText",
                    "props": {
                      "value": "@state.raffleData.name",
                      "placeholder": "Название розыгрыша",
                      "className": "w-full"
                    },
                    "events": [
                      {
                        "type": "onChange",
                        "commands": [
                          {
                            "type": "setProperty",
                            "params": {
                              "source": "event.value",
                              "target": "state.raffleData.name"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": "typeGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "flex flex-column gap-1 mb-2",
              "props": {
                "label": "Тип",
                "labelClassName": "font-bold text-sm",
                "components": [
                  {
                    "id": "typeInput",
                    "type": "component",
                    "componentType": "InputText",
                    "props": {
                      "value": "@state.raffleData.type",
                      "placeholder": "Тип розыгрыша",
                      "className": "w-full"
                    },
                    "events": [
                      {
                        "type": "onChange",
                        "commands": [
                          {
                            "type": "setProperty",
                            "params": {
                              "source": "event.value",
                              "target": "state.raffleData.type"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": "sourcesGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "flex flex-column gap-1 mb-2",
              "props": {
                "label": "Типы источников шансов",
                "labelClassName": "font-bold text-sm",
                "components": [
                  {
                    "id": "sourceMultiSelect",
                    "type": "component",
                    "componentType": "MultiSelect",
                    "props": {
                      "options": "@state.chanceSourceTypes",
                      "value": "@state.raffleData.source_types",
                      "optionLabel": "label",
                      "optionValue": "value",
                      "placeholder": "Выберите типы источников шансов",
                      "showSelectAll": true,
                      "maxSelectedLabels": 3,
                      "selectedItemsLabel": "{0} выбрано",
                      "className": "w-full"
                    },
                    "events": [
                      {
                        "type": "onChange",
                        "commands": [
                          {
                            "type": "setProperty",
                            "params": {
                              "source": "event.value",
                              "target": "state.raffleData.source_types"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "periodBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Даты розыгрыша"
            }
          },
          "className": "flex flex-column",
          "components": [
            {
              "id": "periodFromGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "flex flex-column gap-1 mb-2",
              "props": {
                "label": "Начало сбора",
                "labelClassName": "font-bold text-sm",
                "components": [
                  {
                    "id": "periodFromInput",
                    "type": "component",
                    "componentType": "Calendar",
                    "props": {
                      "value": "@state.raffleData.collection_from",
                      "showTime": true,
                      "hourFormat": "24",
                      "showIcon": true,
                      "placeholder": "Начало периода сбора",
                      "className": "w-full"
                    },
                    "events": [
                      {
                        "type": "onChange",
                        "commands": [
                          {
                            "type": "setProperty",
                            "params": {
                              "source": "event.value",
                              "target": "state.raffleData.collection_from"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": "periodToGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "flex flex-column gap-1 mb-2",
              "props": {
                "label": "Конец сбора",
                "labelClassName": "font-bold text-sm",
                "components": [
                  {
                    "id": "periodToInput",
                    "type": "component",
                    "componentType": "Calendar",
                    "props": {
                      "value": "@state.raffleData.collection_to",
                      "showTime": true,
                      "hourFormat": "24",
                      "showIcon": true,
                      "placeholder": "Конец периода сбора",
                      "className": "w-full"
                    },
                    "events": [
                      {
                        "type": "onChange",
                        "commands": [
                          {
                            "type": "setProperty",
                            "params": {
                              "source": "event.value",
                              "target": "state.raffleData.collection_to"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": "publishAtGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "flex flex-column gap-1 mb-2",
              "props": {
                "label": "Дата публикации",
                "labelClassName": "font-bold text-sm",
                "components": [
                  {
                    "id": "publishAtInput",
                    "type": "component",
                    "componentType": "Calendar",
                    "props": {
                      "value": "@state.raffleData.publish_at",
                      "showTime": true,
                      "hourFormat": "24",
                      "showIcon": true,
                      "placeholder": "Дата публикации розыгрыша",
                      "className": "w-full"
                    },
                    "events": [
                      {
                        "type": "onChange",
                        "commands": [
                          {
                            "type": "setProperty",
                            "params": {
                              "source": "event.value",
                              "target": "state.raffleData.publish_at"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "buttonsSection",
      "type": "section",
      "className": "flex justify-content-center",
      "blocks": [
        {
          "id": "buttonsBlock",
          "type": "block",
          "wrapper": {
            "showHeader": false,
            "component": "Panel",
            "props": {
              "className": "flex-grow-1",
              "pt": {
                "content": {
                  "style": { "background": "var(--surface-50) !important" }
                }
              }
            }
          },
          "className": "flex flex-wrap gap-3 justify-content-center md:justify-content-start",
          "components": [
            {
              "id": "btnSaveAndGo",
              "type": "component",
              "componentType": "Button",
              "props": {
                "label": "Сохранить",
                "icon": "pi pi-check",
                "severity": "success",
                "disabled": "@state.saving"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    "saveRaffle",
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/raffles/{$location.routeParams.raffle_id}",
                        "condition": "{$state.sentSuccessfully}"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "btnApply",
              "type": "component",
              "componentType": "Button",
              "props": {
                "label": "Применить",
                "icon": "pi pi-check",
                "severity": "success",
                "outlined": true,
                "disabled": "@state.saving"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    "saveRaffle",
                    {
                      "type": "showToast",
                      "params": {
                        "severity": "success",
                        "summary": "Успешно",
                        "message": "Данные розыгрыша сохранены",
                        "condition": "{$state.sentSuccessfully}"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "btnCancel",
              "type": "component",
              "componentType": "Button",
              "props": {
                "label": "Отменить изменения",
                "icon": "pi pi-times",
                "severity": "secondary",
                "outlined": true
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/raffles/{$location.routeParams.raffle_id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}