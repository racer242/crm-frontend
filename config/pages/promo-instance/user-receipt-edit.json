{
  "id": "user-receipt-edit",
  "type": "page",
  "route": "/ops/users/[user_id]/receipts/[receipt_id]/edit",
  "state": {
    "loading": false,
    "saving": false,
    "saved": false,
    "sentSuccessfully": false,
    "saveResult": null,
    "userData": {
      "id": "",
      "full_name": "",
      "email": ""
    },
    "receiptData": {
      "id": "",
      "receipt_id": "",
      "user_id": "",
      "status": "",
      "status_label": "",
      "status_severity": "secondary",
      "fn": "",
      "fp": "",
      "fd": "",
      "sum": "",
      "sum_label": "",
      "date": "",
      "date": "",
      "registered_at": "",
      "registered_at": "",
      "decline_reason": ""
    },
    "receiptStatuses": [
      { "label": "На проверке", "value": "CHECKING" },
      { "label": "Принят", "value": "ACCEPTED" },
      { "label": "Отклонён", "value": "REFUSED" },
      { "label": "Приостановлен", "value": "SUSPENDED" },
      { "label": "Требуется фото", "value": "NEED_PHOTO" }
    ],
    "products": {
      "value": [],
      "columns": [],
      "totalRecords": 0
    }
  },
  "meta": {
    "title": "Модерация чека — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}",
      "method": "GET",
      "target": "state.userData"
    },
    {
      "url": "/api/ops/receipts/{$location.routeParams.receipt_id}",
      "method": "GET",
      "target": "state.receiptData"
    },
    {
      "url": "/api/ops/receipts/{$location.routeParams.receipt_id}/products",
      "method": "GET",
      "target": "state.products"
    }
  ],
  "shortcuts": {
    "saveReceipt": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.saving",
              "value": true
            }
          },
          {
            "type": "setProperty",
            "params": {
              "target": "state.saveResult",
              "value": null
            }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/receipts/{$location.routeParams.receipt_id}",
              "method": "PATCH",
              "target": "state.saveResult",
              "data": {
                "status": "{$state.receiptData.status}",
                "decline_reason": "{$state.receiptData.decline_reason}"
              },
              "onSuccess": [
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saving",
                    "value": false
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saved",
                    "value": true
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.sentSuccessfully",
                    "value": true
                  }
                }
              ],
              "onError": [
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saving",
                    "value": false
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.sentSuccessfully",
                    "value": false
                  }
                },
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Не удалось сохранить чек"
                  }
                },
                {
                  "type": "log",
                  "params": {
                    "message": "{$state.saveResult}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": { "icon": "pi pi-home", "url": "/" },
                "model": [
                  { "label": "Участники", "route": "/ops/users" },
                  {
                    "label": "@state.userData.full_name",
                    "route": "/ops/users/{@state.userData.id}"
                  },
                  {
                    "label": "Чеки",
                    "route": "/ops/users/{@state.userData.id}/receipts"
                  },
                  {
                    "label": "Чек",
                    "route": "/ops/users/{@state.userData.id}/receipts/{@state.receiptData.id}"
                  },
                  { "label": "Модерация" }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "production",
                "activeSubitemId": "receipts",
                "pt": { "menu": { "className": "gap-1" } },
                "$ref": "../../menus/user.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "formMainSection",
      "type": "section",
      "className": "",
      "grid": {
        "cols": ["col-12 lg:col-6", "col-12 lg:col-6"],
        "padding": "p-2"
      },
      "blocks": [
        {
          "id": "infoBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Информация о чеке"
            }
          },
          "className": "flex flex-column gap-3",
          "components": [
            {
              "id": "receiptIdGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ID чека",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptIdText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": { "wordBreak": "break-all" },
                    "props": {
                      "value": "@state.receiptData.receipt_id"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptStatusGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Текущий статус",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptStatusTag",
                    "type": "component",
                    "componentType": "Tag",
                    "props": {
                      "value": "@state.receiptData.status_label",
                      "severity": "@state.receiptData.status_severity"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptSumGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Сумма",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptSumText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.sum_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptDateGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата покупки",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptDateText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.date",
                      "dataType": "date"
                  }
                  }
                ]
              }
            },
            {
              "id": "receiptRegisteredGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Зарегистрирован",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptRegisteredText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.registered_at",
                      "dataType": "date"
                  }
                  }
                ]
              }
            },
            {
              "id": "receiptFnGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФН",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFnText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": { "wordBreak": "break-all" },
                    "props": {
                      "value": "@state.receiptData.fn"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptFdGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФД",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFdText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": { "wordBreak": "break-all" },
                    "props": {
                      "value": "@state.receiptData.fd"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptFpGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФП",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFpText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": { "wordBreak": "break-all" },
                    "props": {
                      "value": "@state.receiptData.fp"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "editBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Модерация"
            }
          },
          "className": "flex flex-column",
          "components": [
            {
              "id": "statusGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "flex flex-column gap-1 mb-2",
              "props": {
                "label": "Статус",
                "labelClassName": "font-bold text-sm",
                "components": [
                  {
                    "id": "statusDropdown",
                    "type": "component",
                    "componentType": "Dropdown",
                    "props": {
                      "options": "@state.receiptStatuses",
                      "value": "@state.receiptData.status",
                      "optionLabel": "label",
                      "optionValue": "value",
                      "placeholder": "Выберите статус",
                      "className": "w-full"
                    },
                    "events": [
                      {
                        "type": "onChange",
                        "commands": [
                          {
                            "type": "setProperty",
                            "params": {
                              "source": "event.value",
                              "target": "state.receiptData.status"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            {
              "id": "declineReasonGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "flex flex-column gap-1 mb-2",
              "props": {
                "label": "Причина отклонения",
                "labelClassName": "font-bold text-sm",
                "components": [
                  {
                    "id": "declineReasonInput",
                    "type": "component",
                    "componentType": "InputTextarea",
                    "props": {
                      "value": "@state.receiptData.decline_reason",
                      "rows": 3,
                      "autoResize": true,
                      "className": "w-full",
                      "placeholder": "Указывается при отклонении чека"
                    },
                    "events": [
                      {
                        "type": "onChange",
                        "commands": [
                          {
                            "type": "setProperty",
                            "params": {
                              "source": "event.value",
                              "target": "state.receiptData.decline_reason"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "productsSection",
      "type": "section",
      "className": "mb-5",
      "blocks": [
        {
          "id": "productsBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Продукция в чеке"
            }
          },
          "components": [
            {
              "id": "productsTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.products.value",
                "columns": "@state.products.columns",
                "totalRecords": "@state.products.totalRecords",
                "paginator": false,
                "size": "small",
                "emptyMessage": "Нет продукции в чеке"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "buttonsSection",
      "type": "section",
      "className": "flex justify-content-center",
      "blocks": [
        {
          "id": "buttonsBlock",
          "type": "block",
          "wrapper": {
            "showHeader": false,
            "component": "Panel",
            "props": {
              "className": "flex-grow-1",
              "pt": {
                "content": {
                  "style": { "background": "var(--surface-50) !important" }
                }
              }
            }
          },
          "className": "flex flex-wrap gap-3 justify-content-center md:justify-content-start",
          "components": [
            {
              "id": "btnSaveAndGo",
              "type": "component",
              "componentType": "Button",
              "props": {
                "label": "Сохранить",
                "icon": "pi pi-check",
                "severity": "success",
                "disabled": "@state.saving"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    "saveReceipt",
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/receipts/{$location.routeParams.receipt_id}",
                        "condition": "{$state.sentSuccessfully}"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "btnApply",
              "type": "component",
              "componentType": "Button",
              "props": {
                "label": "Применить",
                "icon": "pi pi-check",
                "severity": "success",
                "outlined": true,
                "disabled": "@state.saving"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    "saveReceipt",
                    {
                      "type": "showToast",
                      "params": {
                        "severity": "success",
                        "summary": "Успешно",
                        "message": "Данные чека сохранены",
                        "condition": "{$state.sentSuccessfully}"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "btnCancel",
              "type": "component",
              "componentType": "Button",
              "props": {
                "label": "Отменить изменения",
                "icon": "pi pi-times",
                "severity": "secondary",
                "outlined": true
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/receipts/{$location.routeParams.receipt_id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}