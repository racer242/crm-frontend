{
  "id": "user-prizes",
  "type": "page",
  "route": "/ops/users/[user_id]/prizes",
  "state": {
    "loading": false,
    "initialized": true,
    "userData": {
      "id": "",
      "full_name": "",
      "email": ""
    },
    "prizes": {
      "value": [],
      "columns": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    }
  },
  "meta": {
    "title": "Призы участника — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}",
      "method": "GET",
      "target": "state.userData"
    },
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}/prizes",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}"
      },
      "method": "GET",
      "target": "state.prizes"
    }
  ],
  "shortcuts": {
    "requestUserPrizes": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/users/{$location.routeParams.user_id}/prizes",
              "method": "GET",
              "target": "state.prizes",
              "data": {
                "event": "{$event}",
                "first": "{$state.prizes.first}",
                "rows": "{$state.prizes.rows}"
              },
              "format": { "$ref": "../../system/list-request-format.json" }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.prizes.first}",
                "rows": "{$state.prizes.rows}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": { "icon": "pi pi-home", "url": "/" },
                "model": [
                  { "label": "Участники", "route": "/ops/users" },
                  {
                    "label": "@state.userData.full_name",
                    "route": "/ops/users/{@state.userData.id}"
                  },
                  { "label": "Призы" }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "achievements",
                "activeSubitemId": "prizes",
                "pt": { "menu": { "className": "gap-1" } },
                "$ref": "../../menus/user.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "prizesHeader",
      "type": "section",
      "className": "flex align-items-center justify-content-between",
      "blocks": [
        {
          "id": "prizesTitle",
          "type": "block",
          "components": [
            {
              "id": "prizesPageTitle",
              "type": "component",
              "componentType": "Text",
              "props": {
                "value": "Призы",
                "level": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "prizesTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "prizesTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "prizesTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.prizes.value",
                "columns": "@state.prizes.columns",
                "totalRecords": "@state.prizes.totalRecords",
                "rows": "@state.prizes.rows",
                "first": "@state.prizes.first",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [5, 10, 25, 50],
                "customColumns": [
                  {
                    "field": "button",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-arrow-right",
                          "link": true,
                          "size": "small",
                          "pt": { "label": { "className": "font-normal" } }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/users/{$location.routeParams.user_id}/prizes/{#row.id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": ["requestUserPrizes"]
                },
                {
                  "type": "onSort",
                  "commands": ["requestUserPrizes"]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/prizes/{$event.data.id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}