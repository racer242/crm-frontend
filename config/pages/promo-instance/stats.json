{
  "id": "stats",
  "type": "page",
  "route": "/ops/stats",
  "state": {
    "loading": false,
    "initialized": true,
    "running": false,
    "search": "",
    "reports": {
      "value": [],
      "columns": [],
      "totalRecords": 0,
      "rows": 25,
      "first": 0
    },
    "selectedReport": {
      "id": "",
      "title": ""
    },
    "selectedDetails": {
      "id": "",
      "title": "",
      "_columns": []
    },
    "params": {
      "startDate": "",
      "endDate": ""
    },
    "result": {
      "value": [],
      "totalRecords": 0,
      "first": 0,
      "rows": 20
    }
  },
  "meta": {
    "title": "Статистика — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/stats/reports",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}",
        "search": "{$location.params.search}",
        "is_active": "true"
      },
      "method": "GET",
      "target": "state.reports"
    }
  ],
  "dataInit": [
    {
      "source": "{$location.params.search}",
      "target": "state.search"
    }
  ],
  "shortcuts": {
    "requestReports": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/stats/reports",
              "method": "GET",
              "target": "state.reports",
              "data": {
                "event": "{$event}",
                "first": "{$state.reports.first}",
                "rows": "{$state.reports.rows}",
                "search": "{$state.search}",
                "is_active": "true"
              },
              "format": { "$ref": "../../system/list-request-format.json" }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.reports.first}",
                "rows": "{$state.reports.rows}",
                "search": "{$state.search}"
              }
            }
          }
        ]
      }
    },
    "selectReport": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "source": "event.data",
              "target": "state.selectedReport"
            }
          },
          {
            "type": "setProperty",
            "params": { "target": "state.result", "value": { "value": [], "totalRecords": 0, "first": 0, "rows": 20 } }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/stats/reports/{$event.data.id}",
              "method": "GET",
              "target": "state.selectedDetails"
            }
          }
        ]
      }
    },
    "runReport": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": { "target": "state.running", "value": true }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/stats/reports/{$state.selectedReport.id}/execute",
              "method": "POST",
              "target": "state.result",
              "data": {
                "first": "{$state.result.first}",
                "rows": "{$state.result.rows}",
                "startDate": "{$state.params.startDate}",
                "endDate": "{$state.params.endDate}"
              },
              "onSuccess": [
                {
                  "type": "setProperty",
                  "params": { "target": "state.running", "value": false }
                }
              ],
              "onError": [
                {
                  "type": "setProperty",
                  "params": { "target": "state.running", "value": false }
                },
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Не удалось выполнить отчёт"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "runReportPage": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": { "target": "state.running", "value": true }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/stats/reports/{$state.selectedReport.id}/execute",
              "method": "POST",
              "target": "state.result",
              "data": {
                "event": "{$event}",
                "first": "{$state.result.first}",
                "rows": "{$state.result.rows}",
                "startDate": "{$state.params.startDate}",
                "endDate": "{$state.params.endDate}"
              },
              "onSuccess": [
                {
                  "type": "setProperty",
                  "params": { "target": "state.running", "value": false }
                }
              ],
              "onError": [
                {
                  "type": "setProperty",
                  "params": { "target": "state.running", "value": false }
                },
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Не удалось выполнить отчёт"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "run",
                "pt": { "menu": { "className": "gap-1" } },
                "$ref": "../../menus/stats.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "statsHeader",
      "type": "section",
      "className": "flex justify-content-between align-items-center",
      "blocks": [
        {
          "id": "statsTitle",
          "type": "block",
          "components": [
            {
              "id": "statsPageTitle",
              "type": "component",
              "componentType": "Text",
              "props": {
                "value": "Статистика",
                "level": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "mainSection",
      "type": "section",
      "grid": { "cols": ["col-12 lg:col-6", "col-12 lg:col-6"], "padding": "" },
      "blocks": [
        {
          "id": "reportsBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "searchInput",
              "type": "component",
              "className": "w-full p-inputtext-sm mb-3",
              "componentType": "InputTextWithThrottle",
              "props": {
                "placeholder": "Поиск по названию...",
                "throttleDelay": 500,
                "value": "@state.search"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.search"
                      }
                    },
                    "requestReports"
                  ]
                }
              ]
            },
            {
              "id": "reportsTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.reports.value",
                "columns": [
                  { "field": "title", "header": "Название" }
                ],
                "totalRecords": "@state.reports.totalRecords",
                "rows": "@state.reports.rows",
                "first": "@state.reports.first",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [5, 10, 25, 50],
                "customColumns": [
                  {
                    "field": "actions",
                    "order": -1,
                    "header": "",
                    "body": [
                      {
                        "id": "btnSelectRow",
                        "componentType": "Button",
                        "style": { "marginLeft": "auto" },
                        "props": {
                          "icon": "pi pi-arrow-right",
                          "link": true,
                          "size": "small",
                          "pt": { "label": { "className": "font-normal" } }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": ["selectReport"]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": ["requestReports"]
                },
                {
                  "type": "onRowClick",
                  "commands": ["selectReport"]
                }
              ]
            }
          ]
        },
        {
          "id": "runBlock",
          "type": "block",
          "className": "w-full flex flex-column gap-3",
          "components": [
            {
              "id": "selectedReportTitle",
              "type": "component",
              "componentType": "Text",
              "props": {
                "value": "@state.selectedReport.title",
                "level": 2
              }
            },
            {
              "id": "paramsPanel",
              "type": "component",
              "componentType": "Panel",
              "className": "w-full",
              "props": {
                "header": "Параметры",
                "components": [
                  {
                    "id": "startDateGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Начало",
                      "labelClassName": "font-bold text-sm",
                      "components": [
                        {
                          "id": "startDateInput",
                          "type": "component",
                          "componentType": "Calendar",
                          "props": {
                            "value": "@state.params.startDate",
                            "showTime": true,
                            "hourFormat": "24",
                            "showIcon": true,
                            "placeholder": "Начало периода",
                            "className": "w-full"
                          },
                          "events": [
                            {
                              "type": "onChange",
                              "commands": [
                                {
                                  "type": "setProperty",
                                  "params": {
                                    "source": "event.value",
                                    "target": "state.params.startDate"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "id": "endDateGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "props": {
                      "label": "Конец",
                      "labelClassName": "font-bold text-sm",
                      "components": [
                        {
                          "id": "endDateInput",
                          "type": "component",
                          "componentType": "Calendar",
                          "props": {
                            "value": "@state.params.endDate",
                            "showTime": true,
                            "hourFormat": "24",
                            "showIcon": true,
                            "placeholder": "Конец периода",
                            "className": "w-full"
                          },
                          "events": [
                            {
                              "type": "onChange",
                              "commands": [
                                {
                                  "type": "setProperty",
                                  "params": {
                                    "source": "event.value",
                                    "target": "state.params.endDate"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "id": "actionsPanel",
              "type": "component",
              "componentType": "Panel",
              "className": "w-full",
              "props": {
                "header": "Выполнение",
                "components": [
                  {
                    "id": "actionsLayout",
                    "type": "component",
                    "componentType": "LayoutGroup",
                    "className": "flex flex-wrap gap-2",
                    "props": {
                      "components": [
                        {
                          "id": "btnRun",
                          "type": "component",
                          "componentType": "Button",
                          "props": {
                            "label": "Запустить",
                            "icon": "pi pi-play",
                            "severity": "success",
                            "disabled": "@state.running",
                            "loading": "@state.running"
                          },
                          "events": [
                            {
                              "type": "onClick",
                              "commands": ["runReport"]
                            }
                          ]
                        },
                        {
                          "id": "btnXlsx",
                          "type": "component",
                          "componentType": "Button",
                          "props": {
                            "label": "Выгрузить XLSX",
                            "icon": "pi pi-file-excel",
                            "severity": "info",
                            "outlined": true
                          },
                          "events": [
                            {
                              "type": "onClick",
                              "commands": [
                                {
                                  "type": "downloadFile",
                                  "params": {
                                    "url": "/api/ops/stats/reports/{$state.selectedReport.id}/export",
                                    "method": "POST",
                                    "data": {
                                      "startDate": "{$state.params.startDate}",
                                      "endDate": "{$state.params.endDate}"
                                    },
                                    "onError": [
                                      {
                                        "type": "showToast",
                                        "params": {
                                          "severity": "error",
                                          "summary": "Ошибка",
                                          "message": "Не удалось выгрузить отчёт"
                                        }
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "resultSection",
      "type": "section",
      "blocks": [
        {
          "id": "resultBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": { "header": "Результат", "className": "w-full" }
          },
          "components": [
            {
              "id": "resultTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.result.value",
                "columns": "@state.selectedDetails._columns",
                "totalRecords": "@state.result.totalRecords",
                "rows": "@state.result.rows",
                "first": "@state.result.first",
                "paginator": true,
                "lazy": true,
                "size": "small",
                "stripedRows": true,
                "rowsPerPageOptions": [10, 20, 50, 100],
                "emptyMessage": "Выберите отчёт и нажмите «Запустить»"
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": ["runReportPage"]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}