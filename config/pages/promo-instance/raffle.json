{
  "id": "raffle",
  "type": "page",
  "route": "/ops/raffles/[raffle_id]",
  "state": {
    "loading": false,
    "initialized": true,
    "saveResult": null,
    "raffleData": {
      "id": "",
      "name": "",
      "name_label": "",
      "type": "",
      "type_label": "",
      "status": "",
      "status_label": "",
      "status_severity": "secondary",
      "collection_from": "",
      "collection_to": "",
      "collection_from_label": "—",
      "collection_to_label": "—",
      "collection_period_label": "—",
      "source_types": [],
      "source_types_label": "—",
      "start_at": "",
      "start_at_label": "—",
      "end_at": "",
      "end_at_label": "—",
      "publish_at": "",
      "publish_at_label": "—",
      "drawn_at": "",
      "drawn_at_label": "—",
      "is_published": false,
      "published_label": "Нет",
      "is_editable": false,
      "edit_disabled": true,
      "is_stale": false,
      "is_stale_label": "Нет",
      "created_at": "",
      "created_at_label": "—",
      "updated_at": "",
      "updated_at_label": "—",
      "booked_chances": "",
      "booked_chances_label": "—",
      "annul_reason": "",
      "annul_reason_label": "—"
    },
    "chancesCount": null
  },
  "meta": {
    "title": "Розыгрыш — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/raffles/{$location.routeParams.raffle_id}",
      "method": "GET",
      "target": "state.raffleData"
    }
  ],
  "shortcuts": {
    "reloadRaffle": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/raffles/{$location.routeParams.raffle_id}",
              "method": "GET",
              "target": "state.raffleData"
            }
          }
        ]
      }
    },
    "publishRaffle": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "confirm",
            "params": {
              "message": "Опубликовать розыгрыш? После публикации его данные будут показаны на фронтенде промо-сайта.",
              "onConfirm": [
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/ops/raffles/publish",
                    "method": "POST",
                    "target": "state.saveResult",
                    "data": {
                      "raffle_id": "{$location.routeParams.raffle_id}"
                    },
                    "onSuccess": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "success",
                          "summary": "Успешно",
                          "message": "Розыгрыш опубликован"
                        }
                      },
                      "reloadRaffle"
                    ],
                    "onError": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "error",
                          "summary": "Ошибка",
                          "message": "Не удалось опубликовать розыгрыш"
                        }
                      }
                    ]
                  }
                }
              ],
              "onCancel": []
            }
          }
        ]
      }
    },
    "startRaffle": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "confirm",
            "params": {
              "message": "Начать проведение розыгрыша? Статус изменится на «Идёт розыгрыш».",
              "onConfirm": [
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/ops/raffles/start",
                    "method": "POST",
                    "target": "state.saveResult",
                    "data": {
                      "raffle_id": "{$location.routeParams.raffle_id}"
                    },
                    "onSuccess": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "success",
                          "summary": "Успешно",
                          "message": "Проведение розыгрыша начато"
                        }
                      },
                      "reloadRaffle"
                    ],
                    "onError": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "error",
                          "summary": "Ошибка",
                          "message": "Не удалось начать проведение розыгрыша"
                        }
                      }
                    ]
                  }
                }
              ],
              "onCancel": []
            }
          }
        ]
      }
    },
    "finishRaffle": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "confirm",
            "params": {
              "message": "Закончить проведение розыгрыша? Статус изменится на «Завершён».",
              "onConfirm": [
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/ops/raffles/finish",
                    "method": "POST",
                    "target": "state.saveResult",
                    "data": {
                      "raffle_id": "{$location.routeParams.raffle_id}"
                    },
                    "onSuccess": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "success",
                          "summary": "Успешно",
                          "message": "Проведение розыгрыша закончено"
                        }
                      },
                      "reloadRaffle"
                    ],
                    "onError": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "error",
                          "summary": "Ошибка",
                          "message": "Не удалось закончить проведение розыгрыша"
                        }
                      }
                    ]
                  }
                }
              ],
              "onCancel": []
            }
          }
        ]
      }
    },
    "draftRaffle": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "confirm",
            "params": {
              "message": "Вернуть розыгрыш в статус «Черновик»?",
              "onConfirm": [
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/ops/raffles/draft",
                    "method": "POST",
                    "target": "state.saveResult",
                    "data": {
                      "raffle_id": "{$location.routeParams.raffle_id}"
                    },
                    "onSuccess": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "success",
                          "summary": "Успешно",
                          "message": "Розыгрыш переведён в черновик"
                        }
                      },
                      "reloadRaffle"
                    ],
                    "onError": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "error",
                          "summary": "Ошибка",
                          "message": "Не удалось перевести розыгрыш в черновик"
                        }
                      }
                    ]
                  }
                }
              ],
              "onCancel": []
            }
          }
        ]
      }
    },
    "annulRaffle": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "confirm",
            "params": {
              "message": "Аннулировать розыгрыш? Статусы и параметры шансов будут сброшены. Действие необратимо.",
              "onConfirm": [
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/ops/raffles/annul",
                    "method": "POST",
                    "target": "state.saveResult",
                    "data": {
                      "raffle_id": "{$location.routeParams.raffle_id}"
                    },
                    "onSuccess": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "success",
                          "summary": "Успешно",
                          "message": "Розыгрыш аннулирован"
                        }
                      },
                      "reloadRaffle"
                    ],
                    "onError": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "error",
                          "summary": "Ошибка",
                          "message": "Не удалось аннулировать розыгрыш"
                        }
                      }
                    ]
                  }
                }
              ],
              "onCancel": []
            }
          }
        ]
      }
    },
    "calculateChances": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.chancesCount",
              "value": null
            }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/raffles/chances/count?raffle_id={$location.routeParams.raffle_id}",
              "method": "GET",
              "target": "state.chancesCount",
              "onSuccess": [
                {
                  "type": "showToast",
                  "params": {
                    "severity": "info",
                    "summary": "Посчитать шансы",
                    "message": "Шансов под условия розыгрыша: {$state.chancesCount.count}"
                  }
                }
              ],
              "onError": [
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Не удалось посчитать шансы"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "downloadProtocol": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "downloadFile",
            "params": {
              "url": "/api/ops/raffles/protocol?raffle_id={$location.routeParams.raffle_id}",
              "method": "GET",
              "filename": "protocol_{$location.routeParams.raffle_id}.json",
              "onError": [
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Не удалось скачать протокол"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": {
                  "icon": "pi pi-home",
                  "url": "/"
                },
                "model": [
                  {
                    "label": "Розыгрыши",
                    "route": "/ops/raffles"
                  },
                  {
                    "label": "@state.raffleData.name_label"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "mainLayout",
      "type": "section",
      "className": "flex mb-5",
      "grid": {
        "cols": [
          "col-12 lg:col-8",
          "col-12 lg:col-4"
        ],
        "padding": "p-2"
      },
      "blocks": [
        {
          "id": "infoBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Информация о розыгрыше",
              "headerComponents": [
                {
                  "id": "raffleRefreshButton",
                  "type": "component",
                  "componentType": "Button",
                  "className": "-m-3",
                  "props": {
                    "icon": "pi pi-refresh",
                    "rounded": true,
                    "text": true,
                    "severity": "secondary",
                    "size": "small",
                    "aria-label": "Обновить",
                    "tooltip": "Обновить",
                    "tooltipOptions": {
                      "position": "left"
                    }
                  },
                  "events": [
                    {
                      "type": "onClick",
                      "commands": [
                        {
                          "type": "refresh",
                          "params": {}
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "className": "flex flex-column gap-3",
          "components": [
            {
              "id": "idGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ID розыгрыша",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "idText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.id"
                    }
                  }
                ]
              }
            },
            {
              "id": "nameGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Название",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "nameText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": {
                      "wordBreak": "break-all"
                    },
                    "props": {
                      "value": "@state.raffleData.name_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "typeGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Тип",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "typeText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.type_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "statusGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Статус",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "statusTag",
                    "type": "component",
                    "componentType": "Tag",
                    "props": {
                      "value": "@state.raffleData.status_label",
                      "severity": "@state.raffleData.status_severity"
                    }
                  }
                ]
              }
            },
            {
              "id": "collectionFromGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата сбора шансов — начало",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "collectionFromText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.collection_from_label",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "collectionToGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата сбора шансов — конец",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "collectionToText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.collection_to_label",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "sourceGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Типы источников шансов",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "sourceText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.source_types_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "startAtGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата начала розыгрыша",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "startAtText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.start_at_label",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "endAtGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата конца розыгрыша",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "endAtText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.end_at_label",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "publishAtGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата публикации",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "publishAtText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.publish_at_label",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "drawnAtGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата проведения",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "drawnAtText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.drawn_at_label",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "publishedGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Опубликован",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "publishedText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.published_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "staleGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Признак «завис»",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "staleText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.is_stale_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "createdGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата создания",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "createdText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.created_at_label",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "updatedGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Дата изменения",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "updatedText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.updated_at_label",
                      "dataType": "date"
                    }
                  }
                ]
              }
            },
            {
              "id": "bookedGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Забронировано шансов",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "bookedText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.booked_chances_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "annulReasonGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Причина аннулирования",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "annulReasonText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.raffleData.annul_reason_label"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "controlBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Управление"
            }
          },
          "className": "flex flex-column gap-3",
          "components": [
            {
              "id": "publishBtn",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-globe",
                "label": "Опубликовать",
                "size": "small",
                "severity": "success",
                "className": "w-full"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    "publishRaffle"
                  ]
                }
              ]
            },
