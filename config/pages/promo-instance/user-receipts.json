{
  "id": "user-receipts",
  "type": "page",
  "route": "/ops/users/[user_id]/receipts",
  "state": {
    "loading": false,
    "initialized": true,
    "filtersVisible": false,
    "userData": {
      "id": "",
      "full_name": "",
      "email": ""
    },
    "receiptsList": {
      "value": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    },
    "receiptsQuery": {
      "sortField": "",
      "sortOrder": 1,
      "search": ""
    },
    "report": {
      "id": "",
      "title": "",
      "columns": [],
      "filters": []
    },
    "pageStateKey": "",
    "savedQuery": ""
  },
  "meta": {
    "title": "Чеки участника — CRM Platform"
  },
  "events": [
    {
      "type": "onLoad",
      "commands": [
        {
          "type": "setProperty",
          "params": {
            "target": "state.pageStateKey",
            "value": "pageState_{$location.pathname}_{$cookie.camp_id}_{$cookie.user_data.id}"
          }
        },
        {
          "type": "getFromLocalStorage",
          "params": {
            "key": "{$state.pageStateKey}",
            "target": "state.savedQuery"
          }
        }
      ]
    }
  ],
  "dataFeed": [
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}",
      "method": "GET",
      "target": "state.userData"
    },
    {
      "url": "/api/ops/receipts/query/receipts",
      "method": "GET",
      "target": "state.report"
    },
    {
      "url": "/api/ops/receipts/query/receipts/execute",
      "method": "POST",
      "target": "state.receiptsList",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}",
        "sortField": "{$location.params.sortField}",
        "sortOrder": "{$location.params.sortOrder}",
        "search": "{$location.params.search}",
        "filters": "{$location.params.filters}",
        "user_id": "{$location.routeParams.user_id}"
      }
    }
  ],
  "dataInit": [
    {
      "source": "{$location.params.search}",
      "target": "state.receiptsQuery.search"
    },
    {
      "source": "{$location.params.sortField}",
      "target": "state.receiptsQuery.sortField"
    },
    {
      "source": "{$location.params.sortOrder}",
      "target": "state.receiptsQuery.sortOrder",
      "parse": "json"
    },
    {
      "source": "{$location.params.filters}",
      "target": "state.report.filters",
      "parse": "json",
      "priority": "feed",
      "method": "merge"
    }
  ],
  "shortcuts": {
    "requestReceipts": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/receipts/query/receipts/execute",
              "method": "POST",
              "target": "state.receiptsList",
              "data": {
                "event": "{$event}",
                "first": "{$state.receiptsList.first}",
                "rows": "{$state.receiptsList.rows}",
                "sortField": "{$state.receiptsQuery.sortField}",
                "sortOrder": "{$state.receiptsQuery.sortOrder}",
                "search": "{$state.receiptsQuery.search}",
                "filters": "{$state.report.filters}",
                "user_id": "{$location.routeParams.user_id}"
              },
              "format": {
                "$ref": "../../system/list-request-format.json"
              }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.receiptsList.first}",
                "rows": "{$state.receiptsList.rows}",
                "sortField": "{$state.receiptsQuery.sortField}",
                "sortOrder": "{$state.receiptsQuery.sortOrder}",
                "search": "{$state.receiptsQuery.search}",
                "filters": "{$state.report.filters}"
              },
              "format": [
                {
                  "prop": "filters",
                  "type": "PopIfHasNullProps",
                  "params": {
                    "props": [
                      "value"
                    ]
                  }
                },
                {
                  "prop": "filters",
                  "type": "RemoveProps",
                  "params": {
                    "props": [
                      "name",
                      "type",
                      "opts"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": {
                  "icon": "pi pi-home",
                  "url": "/"
                },
                "model": [
                  {
                    "label": "Участники",
                    "route": "/ops/users"
                  },
                  {
                    "label": "@state.userData.full_name",
                    "route": "/ops/users/{@state.userData.id}"
                  },
                  {
                    "label": "Чеки"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "production",
                "activeSubitemId": "receipts",
                "pt": {
                  "menu": {
                    "className": "gap-1"
                  }
                },
                "$ref": "../../menus/user.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "receiptsHeader",
      "type": "section",
      "blocks": [
        {
          "id": "receiptsTitle",
          "type": "block",
          "className": "w-full flex gap-3 align-items-center",
          "components": [
            {
              "id": "receiptsPageTitle",
              "type": "component",
              "componentType": "Text",
              "className": "w-full",
              "props": {
                "value": "Чеки",
                "level": 1
              }
            },
            {
              "id": "receiptsRefreshButton",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-refresh",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Обновить",
                "tooltip": "Обновить",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "refresh",
                      "params": {}
                    }
                  ]
                }
              ]
            },
            {
              "id": "userReceiptsSaveStateButton",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-save",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Сохранить состояние",
                "tooltip": "Сохранить состояние",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "sequence",
                      "params": {
                        "commands": [
                          {
                            "type": "setToLocalStorage",
                            "params": {
                              "key": "{$state.pageStateKey}",
                              "value": "{$location.search}"
                            }
                          },
                          {
                            "type": "setProperty",
                            "params": {
                              "target": "state.savedQuery",
                              "value": "{$location.search}"
                            }
                          },
                          {
                            "type": "showToast",
                            "params": {
                              "message": "Состояние сохранено",
                              "severity": "success"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "userReceiptsLoadStateButton",
              "type": "component",
              "componentType": "Button",
              "visible": "@state.savedQuery",
              "props": {
                "icon": "pi pi-history",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Загрузить сохранённое состояние",
                "tooltip": "Загрузить сохранённое",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "sequence",
                      "params": {
                        "commands": [
                          {
                            "type": "setUrlQuery",
                            "params": {
                              "query": "{$state.savedQuery}"
                            }
                          },
                          {
                            "type": "refresh",
                            "params": {}
                          },
                          {
                            "type": "showToast",
                            "params": {
                              "message": "Состояние восстановлено",
                              "severity": "info"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "receiptsFilters",
      "type": "section",
      "className": "flex flex-column gap-3 mb-3",
      "blocks": [
        {
          "id": "receiptsSearchBlock",
          "type": "block",
          "className": "w-full flex gap-3",
          "components": [
            {
              "id": "userReceiptsSearchInput",
              "type": "component",
              "className": "w-full p-inputtext-sm mb-0",
              "componentType": "InputTextWithThrottle",
              "props": {
                "placeholder": "Быстрый поиск...",
                "throttleDelay": 500,
                "value": "@state.receiptsQuery.search"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.receiptsQuery.search"
                      }
                    },
                    "requestReceipts"
                  ]
                }
              ]
            },
            {
              "id": "userReceiptsFindInMgmtButton",
              "type": "component",
              "componentType": "Button",
              "className": "min-w-max flex-grow-0",
              "props": {
                "label": "Найти чеки в модерации",
                "icon": "pi pi-external-link",
                "severity": "secondary",
                "outlined": true,
                "size": "small"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/mgmt/receipts?search={$location.routeParams.user_id}"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "userReceiptsToggleFilters",
              "type": "component",
              "componentType": "Button",
              "className": "min-w-max flex-grow-0 px-3",
              "props": {
                "icon": "pi pi-filter",
                "severity": "primary",
                "outlined": true,
                "size": "small",
                "label": "Фильтры"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "userReceiptsActiveFilterBlock",
          "type": "block",
          "wrapper": {
            "className": "w-full"
          },
          "components": [
            {
              "id": "userReceiptsActiveFilterChips",
              "type": "component",
              "componentType": "ActiveFiltersBar",
              "props": {
                "value": "@state.report.filters"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.report.filters"
                      }
                    },
                    "requestReceipts"
                  ]
                }
              ]
            },
            {
              "id": "userReceiptsFilterDrawer",
              "type": "component",
              "componentType": "FiltersPanel",
              "props": {
                "value": "@state.report.filters",
                "visible": "@state.filtersVisible",
                "position": "right",
                "header": "Фильтры"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.report.filters"
                      }
                    },
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    },
                    "requestReceipts"
                  ]
                },
                {
                  "type": "onHide",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "receiptsTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "receiptsTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "receiptsTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.receiptsList.value",
                "columns": "@state.report.columns",
                "totalRecords": "@state.receiptsList.totalRecords",
                "rows": "@state.receiptsList.rows",
                "first": "@state.receiptsList.first",
                "sortField": "@state.receiptsQuery.sortField",
                "sortOrder": "@state.receiptsQuery.sortOrder",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [
                  5,
                  10,
                  25,
                  50
                ],
                "customColumns": [
                  {
                    "field": "nav",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-arrow-right",
                          "link": true,
                          "size": "small"
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/users/{$location.routeParams.user_id}/receipts/{#row.receipt_id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": [
                    "requestReceipts"
                  ]
                },
                {
                  "type": "onSort",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.sortField",
                        "target": "state.receiptsQuery.sortField"
                      }
                    },
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.sortOrder",
                        "target": "state.receiptsQuery.sortOrder"
                      }
                    },
                    "requestReceipts"
                  ]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/receipts/{$event.data.receipt_id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
