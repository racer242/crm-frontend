{
  "id": "user-receipts",
  "type": "page",
  "route": "/ops/users/[user_id]/receipts",
  "state": {
    "loading": false,
    "initialized": true,
    "userData": {
      "id": "",
      "full_name": "",
      "email": ""
    },
    "receipts": {
      "value": [],
      "columns": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    }
  },
  "meta": {
    "title": "Чеки участника — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}",
      "method": "GET",
      "target": "state.userData"
    },
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}/receipts",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}"
      },
      "method": "GET",
      "target": "state.receipts"
    }
  ],
  "shortcuts": {
    "requestUserReceipts": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/users/{$location.routeParams.user_id}/receipts",
              "method": "GET",
              "target": "state.receipts",
              "data": {
                "event": "{$event}",
                "first": "{$state.receipts.first}",
                "rows": "{$state.receipts.rows}"
              },
              "format": { "$ref": "../../system/list-request-format.json" }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.receipts.first}",
                "rows": "{$state.receipts.rows}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": { "icon": "pi pi-home", "url": "/" },
                "model": [
                  { "label": "Участники", "route": "/ops/users" },
                  {
                    "label": "@state.userData.full_name",
                    "route": "/ops/users/{@state.userData.id}"
                  },
                  { "label": "Чеки" }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "production",
                "activeSubitemId": "receipts",
                "pt": { "menu": { "className": "gap-1" } },
                "$ref": "../../menus/user.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "receiptsHeader",
      "type": "section",
      "className": "flex align-items-center justify-content-between",
      "blocks": [
        {
          "id": "receiptsTitle",
          "type": "block",
          "components": [
            {
              "id": "receiptsPageTitle",
              "type": "component",
              "componentType": "Text",
              "props": {
                "value": "Чеки",
                "level": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "receiptsTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "receiptsTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "receiptsTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.receipts.value",
                "columns": "@state.receipts.columns",
                "totalRecords": "@state.receipts.totalRecords",
                "rows": "@state.receipts.rows",
                "first": "@state.receipts.first",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [5, 10, 25, 50],
                "customColumns": [
                  {
                    "field": "button",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-arrow-right",
                          "link": true,
                          "size": "small",
                          "pt": { "label": { "className": "font-normal" } }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/users/{$location.routeParams.user_id}/receipts/{#row.id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": ["requestUserReceipts"]
                },
                {
                  "type": "onSort",
                  "commands": ["requestUserReceipts"]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/receipts/{$event.data.id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}