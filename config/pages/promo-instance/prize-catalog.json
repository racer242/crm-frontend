{
  "id": "prize-catalog",
  "type": "page",
  "route": "/ops/prize-catalog",
  "state": {
    "loading": false,
    "initialized": true,
    "filtersVisible": false,
    "prizeCatalog": {
      "value": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    },
    "prizeCatalogQuery": {
      "sortField": "",
      "sortOrder": -1,
      "search": ""
    },
    "report": {
      "id": "",
      "title": "",
      "columns": [],
      "filters": []
    },
    "pageStateKey": "",
    "savedQuery": "",
    "prizeDialog": {},
    "prizeDialogVisible": false
  },
  "meta": {
    "title": "Каталог призов — CRM Platform"
  },
  "events": [
    {
      "type": "onLoad",
      "commands": [
        {
          "type": "setProperty",
          "params": {
            "target": "state.pageStateKey",
            "value": "pageState_{$location.pathname}_{$cookie.camp_id}_{$cookie.user_data.id}"
          }
        },
        {
          "type": "getFromLocalStorage",
          "params": {
            "key": "{$state.pageStateKey}",
            "target": "state.savedQuery"
          }
        }
      ]
    }
  ],
  "dataFeed": [
    {
      "url": "/api/ops/prize-catalog",
      "method": "GET",
      "target": "state.report"
    },
    {
      "url": "/api/ops/prize-catalog/execute",
      "method": "POST",
      "target": "state.prizeCatalog",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}",
        "sortField": "{$location.params.sortField}",
        "sortOrder": "{$location.params.sortOrder}",
        "search": "{$location.params.search}",
        "filters": "{$location.params.filters}"
      }
    }
  ],
  "dataInit": [
    {
      "source": "{$location.params.search}",
      "target": "state.prizeCatalogQuery.search"
    },
    {
      "source": "{$location.params.sortField}",
      "target": "state.prizeCatalogQuery.sortField"
    },
    {
      "source": "{$location.params.sortOrder}",
      "target": "state.prizeCatalogQuery.sortOrder",
      "parse": "json"
    },
    {
      "source": "{$location.params.filters}",
      "target": "state.report.filters",
      "parse": "json",
      "priority": "feed",
      "method": "merge"
    }
  ],
  "shortcuts": {
    "requestPrizeCatalog": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/prize-catalog/execute",
              "method": "POST",
              "target": "state.prizeCatalog",
              "data": {
                "event": "{$event}",
                "first": "{$state.prizeCatalog.first}",
                "rows": "{$state.prizeCatalog.rows}",
                "sortField": "{$state.prizeCatalogQuery.sortField}",
                "sortOrder": "{$state.prizeCatalogQuery.sortOrder}",
                "search": "{$state.prizeCatalogQuery.search}",
                "filters": "{$state.report.filters}"
              },
              "format": {
                "$ref": "../../system/list-request-format.json"
              }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.prizeCatalog.first}",
                "rows": "{$state.prizeCatalog.rows}",
                "sortField": "{$state.prizeCatalogQuery.sortField}",
                "sortOrder": "{$state.prizeCatalogQuery.sortOrder}",
                "search": "{$state.prizeCatalogQuery.search}",
                "filters": "{$state.report.filters}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "catalog",
                "pt": {
                  "menu": {
                    "className": "gap-1"
                  }
                },
                "$ref": "../../menus/prizes.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "catalogHeader",
      "type": "section",
      "blocks": [
        {
          "id": "catalogTitle",
          "type": "block",
          "className": "w-full flex gap-3 align-items-center",
          "components": [
            {
              "id": "catalogPageTitle",
              "type": "component",
              "componentType": "Text",
              "className": "w-full",
              "props": {
                "value": "Каталог призов",
                "level": 1
              }
            },
            {
              "id": "catalogRefreshButton",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-refresh",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Обновить",
                "tooltip": "Обновить",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "refresh",
                      "params": {}
                    }
                  ]
                }
              ]
            },
            {
              "id": "catalogSaveStateButton",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-save",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Сохранить состояние",
                "tooltip": "Сохранить состояние",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "sequence",
                      "params": {
                        "commands": [
                          {
                            "type": "setToLocalStorage",
                            "params": {
                              "key": "{$state.pageStateKey}",
                              "value": "{$location.search}"
                            }
                          },
                          {
                            "type": "setProperty",
                            "params": {
                              "target": "state.savedQuery",
                              "value": "{$location.search}"
                            }
                          },
                          {
                            "type": "showToast",
                            "params": {
                              "message": "Состояние сохранено",
                              "severity": "success"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "catalogLoadStateButton",
              "type": "component",
              "componentType": "Button",
              "visible": "@state.savedQuery",
              "props": {
                "icon": "pi pi-history",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Загрузить сохранённое состояние",
                "tooltip": "Загрузить сохранённое",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "sequence",
                      "params": {
                        "commands": [
                          {
                            "type": "setUrlQuery",
                            "params": {
                              "query": "{$state.savedQuery}"
                            }
                          },
                          {
                            "type": "refresh",
                            "params": {}
                          },
                          {
                            "type": "showToast",
                            "params": {
                              "message": "Состояние восстановлено",
                              "severity": "info"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "catalogFilters",
      "type": "section",
      "className": "flex flex-column gap-3 mb-3",
      "blocks": [
        {
          "id": "catalogSearchBlock",
          "type": "block",
          "className": "w-full flex gap-3",
          "components": [
            {
              "id": "catalogSearchInput",
              "type": "component",
              "className": "w-full p-inputtext-sm mb-0",
              "componentType": "InputTextWithThrottle",
              "props": {
                "placeholder": "Быстрый поиск...",
                "throttleDelay": 500,
                "value": "@state.prizeCatalogQuery.search"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.prizeCatalogQuery.search"
                      }
                    },
                    "requestPrizeCatalog"
                  ]
                }
              ]
            },
            {
              "id": "catalogToggleFilters",
              "type": "component",
              "componentType": "Button",
              "className": "min-w-max flex-grow-0 px-3",
              "props": {
                "icon": "pi pi-filter",
                "severity": "primary",
                "outlined": true,
                "size": "small",
                "label": "Фильтры"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "catalogActiveFilterBlock",
          "type": "block",
          "wrapper": {
            "className": "w-full"
          },
          "components": [
            {
              "id": "catalogActiveFilterChips",
              "type": "component",
              "componentType": "ActiveFiltersBar",
              "props": {
                "value": "@state.report.filters"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.report.filters"
                      }
                    },
                    "requestPrizeCatalog"
                  ]
                }
              ]
            },
            {
              "id": "catalogFilterDrawer",
              "type": "component",
              "componentType": "FiltersPanel",
              "props": {
                "value": "@state.report.filters",
                "visible": "@state.filtersVisible",
                "position": "right",
                "header": "Фильтры"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.report.filters"
                      }
                    },
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    },
                    "requestPrizeCatalog"
                  ]
                },
                {
                  "type": "onHide",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "catalogTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "catalogTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "catalogTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.prizeCatalog.value",
                "columns": "@state.report.columns",
                "totalRecords": "@state.prizeCatalog.totalRecords",
                "rows": "@state.prizeCatalog.rows",
                "first": "@state.prizeCatalog.first",
                "sortField": "@state.prizeCatalogQuery.sortField",
                "sortOrder": "@state.prizeCatalogQuery.sortOrder",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "rowsPerPageOptions": [
                  5,
                  10,
                  25,
                  50
                ],
                "customColumns": [
                  {
                    "field": "prizeDetails",
                    "header": "",
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-eye",
                          "severity": "secondary",
                          "text": true,
                          "rounded": true,
                          "size": "large"
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "setProperty",
                                "params": {
                                  "target": "state.prizeDialogVisible",
                                  "value": true
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": [
                    "requestPrizeCatalog"
                  ]
                },
                {
                  "type": "onSort",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.sortField",
                        "target": "state.prizeCatalogQuery.sortField"
                      }
                    },
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.sortOrder",
                        "target": "state.prizeCatalogQuery.sortOrder"
                      }
                    },
                    "requestPrizeCatalog"
                  ]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.data",
                        "target": "state.prizeDialog"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "prizeDialogSection",
      "type": "section",
      "blocks": [
        {
          "id": "prizeDialogBlock",
          "type": "block",
          "components": [
            {
              "id": "prizeDialog",
              "type": "component",
              "componentType": "Dialog",
              "props": {
                "header": "@state.prizeDialog.title",
                "visible": "@state.prizeDialogVisible",
                "modal": true,
                "closable": true,
                "draggable": false,
                "resizable": false,
                "style": {
                  "width": "560px"
                },
                "containerClassName": "flex flex-column gap-1",
                "components": [
                  {
                    "id": "prizeDialogIdentityTitle",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 text-sm font-semibold",
                    "props": {
                      "value": "Идентификация"
                    }
                  },
                  {
                    "id": "prizeDialogIdGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "ID приза",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogId",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 text-xs text-500",
                          "props": {
                            "value": "@state.prizeDialog.prize_id"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogCodeGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Код в CRM",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogCode",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.code"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogTypeGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Группа (тип)",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogType",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.type_code"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogDescriptionTitle",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 text-sm font-semibold",
                    "props": {
                      "value": "Описание"
                    }
                  },
                  {
                    "id": "prizeDialogDescriptionGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Описание",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogDescription",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 white-space-pre-line",
                          "props": {
                            "value": "@state.prizeDialog.description"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogPricingTitle",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 text-sm font-semibold",
                    "props": {
                      "value": "Стоимость и план"
                    }
                  },
                  {
                    "id": "prizeDialogPriceGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Стоимость, ₽ (для акта)",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogPrice",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.price_rub"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogPointsGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Цена в баллах",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogPoints",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.points_cost"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogTargetGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Плановое кол-во экземпляров",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogTarget",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.target_count"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogStatusesTitle",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 text-sm font-semibold",
                    "props": {
                      "value": "Статусы"
                    }
                  },
                  {
                    "id": "prizeDialogActRequiredGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Нужен акт получения",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogActRequired",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.act_required"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogActiveGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Видимость участнику",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogActive",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.active"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogIsRemovedGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Наличие в плане CRM",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogIsRemoved",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.is_removed"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogDatesTitle",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 text-sm font-semibold",
                    "props": {
                      "value": "Даты"
                    }
                  },
                  {
                    "id": "prizeDialogCreatedAtGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Дата создания",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogCreatedAt",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.created_at",
                            "dataType": "date"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogUpdatedAtGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Дата обновления",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogUpdatedAt",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0",
                          "props": {
                            "value": "@state.prizeDialog.updated_at",
                            "dataType": "date"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogImageTitle",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 text-sm font-semibold",
                    "props": {
                      "value": "Картинка"
                    }
                  },
                  {
                    "id": "prizeDialogImageGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Источник картинки",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogImage",
                          "type": "component",
                          "componentType": "Image",
                          "visible": "@state.prizeDialog.image_source_url",
                          "props": {
                            "src": "@state.prizeDialog.image_source_url",
                            "alt": "@state.prizeDialog.title",
                            "preview": true,
                            "width": "300"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogImagePathGroup",
                    "type": "component",
                    "componentType": "LabelledGroup",
                    "className": "mb-3",
                    "props": {
                      "label": "Картинка (локальный адрес)",
                      "labelClassName": "text-sm text-500",
                      "components": [
                        {
                          "id": "prizeDialogImagePath",
                          "type": "component",
                          "componentType": "Text",
                          "className": "m-0 text-xs text-500",
                          "props": {
                            "value": "@state.prizeDialog.image"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "prizeDialogActions",
                    "type": "component",
                    "componentType": "LayoutGroup",
