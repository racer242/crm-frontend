{
  "id": "user",
  "type": "page",
  "route": "/ops/users/[user_id]",
  "state": {
    "loading": false,
    "initialized": true,
    "userData": {
      "id": "",
      "first_name": "",
      "last_name": "",
      "third_name": "",
      "full_name": "",
      "initials": "",
      "points": 0,
      "email": "",
      "phone": "",
      "created_at": "",
      "city": "",
      "status": "",
      "mailing": "",
      "status_label": "",
      "status_severity": ""
    },
    "productData": {
      "receipts": 0,
      "products": 0
    },
    "achevementsData": {
      "prizes": 0
    },
    "feedbackData": {
      "messages": 0
    }
  },
  "meta": {
    "title": "Участник — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/users/{$location.routeParams.user_id}",
      "method": "GET",
      "target": "state.userData"
    }
  ],
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": { "icon": "pi pi-home", "url": "/" },
                "model": [
                  { "label": "Участники", "route": "/ops/users" },
                  { "label": "@state.userData.full_name" }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "profile",
                "pt": { "menu": { "className": "gap-1" } },
                "$ref": "../../menus/user.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "statsRowSection",
      "type": "section",
      "className": "flex flex-column",
      "blocks": [
        {
          "id": "statCardsBlock",
          "type": "block",
          "className": "mb-5",
          "grid": {
            "cols": ["col-6 lg:col-4", "col-6 lg:col-4", "col-12 lg:col-4"],
            "padding": "p-2"
          },
          "components": [
            {
              "id": "activityReceipts",
              "type": "component",
              "componentType": "StatCard",
              "className": "h-full p-1",
              "props": {
                "title": "Чеки",
                "subTitle": "проверены",
                "value": "@state.productData.receipts",
                "icon": "pi pi-receipt"
              }
            },
            {
              "id": "activityProducts",
              "type": "component",
              "componentType": "StatCard",
              "className": "h-full p-1",
              "props": {
                "title": "Продукты",
                "subTitle": "акционные",
                "value": "@state.productData.products",
                "icon": "pi pi-shopping-cart"
              },
              "state": {}
            },
            {
              "id": "feedbackMessages",
              "type": "component",
              "componentType": "StatCard",
              "className": "h-full p-1",
              "props": {
                "title": "Сообщения",
                "subTitle": "",
                "value": "@state.feedbackData.messages",
                "icon": "pi pi-envelope"
              },
              "state": {}
            }
          ]
        }
      ]
    },
    {
      "id": "mainLayout",
      "type": "section",
      "className": "flex mb-5",
      "grid": {
        "cols": ["col-12 lg:col-6", "col-12 lg:col-6"],
        "padding": "p-2"
      },
      "blocks": [
        {
          "id": "leftColumnBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Профиль"
            }
          },
          "className": "flex flex-column align-items-center gap-1",
          "components": [
            {
              "id": "userAvatarNameGroup",
              "type": "component",
              "componentType": "LayoutGroup",
              "className": "flex flex-column md:flex-row gap-3 justify-content-center align-items-center my-3 lg:my-6",
              "props": {
                "components": [
                  {
                    "id": "userAvatar",
                    "type": "component",
                    "componentType": "Avatar",
                    "props": {
                      "label": "@state.userData.initials",
                      "shape": "circle",
                      "size": "xlarge"
                    },
                    "state": {}
                  },
                  {
                    "id": "userNameGroup",
                    "type": "component",
                    "componentType": "LayoutGroup",
                    "className": "flex flex-column align-items-center gap-1",
                    "props": {
                      "components": [
                        {
                          "id": "userFullName",
                          "type": "component",
                          "componentType": "Text",
                          "props": {
                            "value": "@state.userData.full_name",
                            "level": 1
                          },
                          "className": "text-center md:text-left",
                          "state": {}
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "id": "userDivider1",
              "type": "component",
              "componentType": "Divider",
              "className": "w-full"
            },
            {
              "id": "userEmailGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Email",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "userEmail",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": { "wordBreak": "break-all" },
                    "props": {
                      "value": "@state.userData.email"
                    },
                    "state": {}
                  }
                ]
              }
            },
            {
              "id": "userPhoneGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Телефон",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "userPhone",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.userData.phone"
                    },
                    "state": {}
                  }
                ]
              }
            },
            {
              "id": "userCityGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center",
              "props": {
                "label": "Город",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "userCity",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.userData.city"
                    },
                    "state": {}
                  }
                ]
              }
            },

            {
              "id": "userDivider3",
              "type": "component",
              "componentType": "Divider",
              "className": "w-full"
            },
            {
              "id": "userStatusGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center",
              "props": {
                "label": "Статус",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "blockStatusTag",
                    "type": "component",
                    "componentType": "Tag",
                    "className": "text-sm px-2 py-1",
                    "props": {
                      "value": "@state.userData.status_label",
                      "severity": "@state.userData.status_severity"
                    },
                    "state": {}
                  }
                ]
              }
            },
            {
              "id": "userDivider4",
              "type": "component",
              "componentType": "Divider",
              "className": "w-full"
            },
            {
              "id": "btnEditUser",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-pencil",
                "label": "Редактировать",
                "size": "small",
                "severity": "info"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$location.routeParams.user_id}/edit"
                      }
                    }
                  ]
                }
              ],
              "state": {}
            }
          ]
        },
        {
          "id": "rightColumnBlock",
          "type": "block",
          "className": "flex flex-column",
          "components": [
            {
              "id": "userAvatarNameGroup",
              "type": "component",
              "componentType": "LayoutGroup",
              "className": "mb-3",
              "props": {
                "grid": {
                  "cols": ["col-6", "col-6"],
                  "padding": "p-2"
                },
                "components": [
                  {
                    "id": "activityPoints",
                    "type": "component",
                    "componentType": "StatCard",
                    "className": "h-full",
                    "style": {
                      "backgroundColor": "var(--primary-color)",
                      "color": "var(--primary-color-text)"
                    },
                    "props": {
                      "titleClassName": "text-base",
                      "valueClassName": "text-4xl font-bold mt-1",
                      "iconClassName": "text-2xl text-primary",
                      "title": "Баллы",
                      "value": "@state.userData.points",
                      "icon": "pi pi-trophy"
                    },
                    "state": {}
                  },
                  {
                    "id": "activityPrizes",
                    "type": "component",
                    "componentType": "StatCard",
                    "className": "h-full",
                    "style": {
                      "backgroundColor": "var(--primary-color)",
                      "color": "var(--primary-color-text)"
                    },
                    "props": {
                      "titleClassName": "text-base",
                      "valueClassName": "text-4xl font-bold mt-1",
                      "iconClassName": "text-2xl text-primary",
                      "title": "Призы",
                      "value": "@state.achevementsData.prizes",
                      "icon": "pi pi-gift"
                    },
                    "state": {}
                  }
                ]
              }
            },
            {
              "id": "detailsTable",
              "type": "component",
              "componentType": "DataTable",
              "className": "no-bottom-border mb-4",
              "props": {
                "showHeaders": false,
                "value": [
                  { "label": "ID", "value": "@state.userData.id" },
                  {
                    "label": "Код",
                    "value": "@state.userData.participant_code"
                  },
                  {
                    "label": "Полное имя",
                    "value": "@state.userData.complete_name"
                  },
                  {
                    "label": "Дата регистрации",
                    "value": "@state.userData.created_at"
                  },
                  {
                    "label": "Согласие на рассылку",
                    "value": "@state.userData.mailing"
                  }
                ],
                "columns": [{ "field": "label" }, { "field": "value" }]
              },
              "state": {}
            }
          ]
        }
      ]
    }
  ]
}
