{
  "id": "prizes",
  "type": "page",
  "route": "/ops/prizes",
  "state": {
    "loading": false,
    "initialized": true,
    "prizes": {
      "value": [],
      "columns": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    }
  },
  "meta": {
    "title": "Призы — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/prizes",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}"
      },
      "method": "GET",
      "target": "state.prizes"
    }
  ],
  "shortcuts": {
    "requestPrizes": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/prizes",
              "method": "GET",
              "target": "state.prizes",
              "data": {
                "event": "{$event}",
                "first": "{$state.prizes.first}",
                "rows": "{$state.prizes.rows}"
              },
              "format": {
                "$ref": "../../system/list-request-format.json"
              }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.prizes.first}",
                "rows": "{$state.prizes.rows}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "prizesHeader",
      "type": "section",
      "blocks": [
        {
          "id": "prizesTitle",
          "type": "block",
          "className": "w-full flex gap-3 align-items-center",
          "components": [
            {
              "id": "prizesPageTitle",
              "type": "component",
              "componentType": "Text",
              "className": "w-full",
              "props": {
                "value": "Призы",
                "level": 1
              }
            },
            {
              "id": "prizesRefreshButton",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-refresh",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Обновить",
                "tooltip": "Обновить",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "refresh",
                      "params": {}
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "prizesTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "prizesTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "prizesTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.prizes.value",
                "columns": "@state.prizes.columns",
                "totalRecords": "@state.prizes.totalRecords",
                "rows": "@state.prizes.rows",
                "first": "@state.prizes.first",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [
                  5,
                  10,
                  25,
                  50
                ],
                "customColumns": [
                  {
                    "field": "button",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-arrow-right",
                          "link": true,
                          "size": "small",
                          "pt": {
                            "label": {
                              "className": "font-normal"
                            }
                          }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/prizes/{#row.id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": [
                    "requestPrizes"
                  ]
                },
                {
                  "type": "onSort",
                  "commands": [
                    "requestPrizes"
                  ]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/prizes/{$event.data.id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}