{
  "id": "prizes",
  "type": "page",
  "route": "/ops/prizes",
  "state": {
    "loading": false,
    "initialized": true,
    "filtersVisible": false,
    "prizes": {
      "value": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    },
    "prizesQuery": {
      "sortField": "",
      "sortOrder": -1,
      "search": ""
    },
    "report": {
      "id": "",
      "title": "",
      "columns": [],
      "filters": []
    },
    "pageStateKey": "",
    "savedQuery": ""
  },
  "meta": {
    "title": "Призы — CRM Platform"
  },
  "events": [
    {
      "type": "onLoad",
      "commands": [
        {
          "type": "setProperty",
          "params": {
            "target": "state.pageStateKey",
            "value": "pageState_{$location.pathname}_{$cookie.camp_id}_{$cookie.user_data.id}"
          }
        },
        {
          "type": "getFromLocalStorage",
          "params": {
            "key": "{$state.pageStateKey}",
            "target": "state.savedQuery"
          }
        }
      ]
    }
  ],
  "dataFeed": [
    {
      "url": "/api/ops/prizes",
      "method": "GET",
      "target": "state.report"
    },
    {
      "url": "/api/ops/prizes/execute",
      "method": "POST",
      "target": "state.prizes",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}",
        "sortField": "{$location.params.sortField}",
        "sortOrder": "{$location.params.sortOrder}",
        "search": "{$location.params.search}",
        "filters": "{$location.params.filters}"
      }
    }
  ],
  "dataInit": [
    {
      "source": "{$location.params.search}",
      "target": "state.prizesQuery.search"
    },
    {
      "source": "{$location.params.sortField}",
      "target": "state.prizesQuery.sortField"
    },
    {
      "source": "{$location.params.sortOrder}",
      "target": "state.prizesQuery.sortOrder",
      "parse": "json"
    },
    {
      "source": "{$location.params.filters}",
      "target": "state.report.filters",
      "parse": "json",
      "priority": "feed",
      "method": "merge"
    }
  ],
  "shortcuts": {
    "requestPrizes": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/prizes/execute",
              "method": "POST",
              "target": "state.prizes",
              "data": {
                "event": "{$event}",
                "first": "{$state.prizes.first}",
                "rows": "{$state.prizes.rows}",
                "sortField": "{$state.prizesQuery.sortField}",
                "sortOrder": "{$state.prizesQuery.sortOrder}",
                "search": "{$state.prizesQuery.search}",
                "filters": "{$state.report.filters}"
              },
              "format": {
                "$ref": "../../system/list-request-format.json"
              }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.prizes.first}",
                "rows": "{$state.prizes.rows}",
                "sortField": "{$state.prizesQuery.sortField}",
                "sortOrder": "{$state.prizesQuery.sortOrder}",
                "search": "{$state.prizesQuery.search}",
                "filters": "{$state.report.filters}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "menuSection",
      "type": "section",
      "blocks": [
        {
          "id": "menuBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "menubar",
              "type": "component",
              "componentType": "Menubar",
              "props": {
                "activeItemId": "prizes",
                "pt": {
                  "menu": {
                    "className": "gap-1"
                  }
                },
                "$ref": "../../menus/prizes.json"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "prizesHeader",
      "type": "section",
      "blocks": [
        {
          "id": "prizesTitle",
          "type": "block",
          "className": "w-full flex gap-3 align-items-center",
          "components": [
            {
              "id": "prizesPageTitle",
              "type": "component",
              "componentType": "Text",
              "className": "w-full",
              "props": {
                "value": "Призы",
                "level": 1
              }
            },
            {
              "id": "prizesRefreshButton",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-refresh",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Обновить",
                "tooltip": "Обновить",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    "requestPrizes"
                  ]
                }
              ]
            },
            {
              "id": "prizesSaveStateButton",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-save",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Сохранить состояние",
                "tooltip": "Сохранить состояние",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "sequence",
                      "params": {
                        "commands": [
                          {
                            "type": "setToLocalStorage",
                            "params": {
                              "key": "{$state.pageStateKey}",
                              "value": "{$location.search}"
                            }
                          },
                          {
                            "type": "setProperty",
                            "params": {
                              "target": "state.savedQuery",
                              "value": "{$location.search}"
                            }
                          },
                          {
                            "type": "showToast",
                            "params": {
                              "message": "Состояние сохранено",
                              "severity": "success"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "prizesLoadStateButton",
              "type": "component",
              "componentType": "Button",
              "visible": "@state.savedQuery",
              "props": {
                "icon": "pi pi-history",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Загрузить сохранённое состояние",
                "tooltip": "Загрузить сохранённое",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "sequence",
                      "params": {
                        "commands": [
                          {
                            "type": "setUrlQuery",
                            "params": {
                              "query": "{$state.savedQuery}"
                            }
                          },
                          {
                            "type": "refresh",
                            "params": {}
                          },
                          {
                            "type": "showToast",
                            "params": {
                              "message": "Состояние восстановлено",
                              "severity": "info"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "prizesFilters",
      "type": "section",
      "className": "flex flex-column gap-3 mb-3",
      "blocks": [
        {
          "id": "prizesSearchBlock",
          "type": "block",
          "className": "w-full flex gap-3",
          "components": [
            {
              "id": "prizesSearchInput",
              "type": "component",
              "className": "w-full p-inputtext-sm mb-0",
              "componentType": "InputTextWithThrottle",
              "props": {
                "placeholder": "Быстрый поиск...",
                "throttleDelay": 500,
                "value": "@state.prizesQuery.search"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.prizesQuery.search"
                      }
                    },
                    "requestPrizes"
                  ]
                }
              ]
            },
            {
              "id": "prizesToggleFilters",
              "type": "component",
              "componentType": "Button",
              "className": "min-w-max flex-grow-0 px-3",
              "props": {
                "icon": "pi pi-filter",
                "severity": "primary",
                "outlined": true,
                "size": "small",
                "label": "Фильтры"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "prizesActiveFilterBlock",
          "type": "block",
          "wrapper": {
            "className": "w-full"
          },
          "components": [
            {
              "id": "prizesActiveFilterChips",
              "type": "component",
              "componentType": "ActiveFiltersBar",
              "props": {
                "value": "@state.report.filters"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.report.filters"
                      }
                    },
                    "requestPrizes"
                  ]
                }
              ]
            },
            {
              "id": "prizesFilterDrawer",
              "type": "component",
              "componentType": "FiltersPanel",
              "props": {
                "value": "@state.report.filters",
                "visible": "@state.filtersVisible",
                "position": "right",
                "header": "Фильтры"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.report.filters"
                      }
                    },
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    },
                    "requestPrizes"
                  ]
                },
                {
                  "type": "onHide",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "prizesTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "prizesTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "prizesTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.prizes.value",
                "columns": "@state.report.columns",
                "totalRecords": "@state.prizes.totalRecords",
                "rows": "@state.prizes.rows",
                "first": "@state.prizes.first",
                "sortField": "@state.prizesQuery.sortField",
                "sortOrder": "@state.prizesQuery.sortOrder",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [
                  5,
                  10,
                  25,
                  50
                ],
                "customColumns": [
                  {
                    "field": "user_id",
                    "header": "",
                    "body": [
                      {
                        "componentType": "Button",
                        "visibleRow": "{#row.user_id}",
                        "props": {
                          "icon": "pi pi-user",
                          "link": true,
                          "size": "small",
                          "aria-label": "Перейти к участнику",
                          "tooltip": "Перейти к участнику",
                          "tooltipOptions": {
                            "position": "left"
                          }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/users/{#row.user_id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "field": "nav",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-arrow-right",
                          "link": true,
                          "size": "small",
                          "pt": {
                            "label": {
                              "className": "font-normal"
                            }
                          }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/prizes/{#row.instance_id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": [
                    "requestPrizes"
                  ]
                },
                {
                  "type": "onSort",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.sortField",
                        "target": "state.prizesQuery.sortField"
                      }
                    },
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.sortOrder",
                        "target": "state.prizesQuery.sortOrder"
                      }
                    },
                    "requestPrizes"
                  ]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/prizes/{$event.data.instance_id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}