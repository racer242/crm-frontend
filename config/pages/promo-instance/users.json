{
  "id": "users",
  "type": "page",
  "route": "/ops/users",
  "state": {
    "loading": false,
    "initialized": true,
    "filtersVisible": false,
    "users": {
      "value": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    },
    "usersQuery": {
      "sortField": "",
      "sortOrder": 1,
      "search": ""
    },
    "report": {
      "id": "",
      "title": "",
      "columns": [],
      "filters": []
    }
  },
  "meta": {
    "title": "Участники — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/users-v2/report/01a116ba-7fc2-74ba-9b0a-4b06ed7f7c79",
      "method": "GET",
      "target": "state.report"
    },
    {
      "url": "/api/ops/users-v2/query/users/execute",
      "method": "POST",
      "target": "state.users",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}",
        "sortField": "{$location.params.sortField}",
        "sortOrder": "{$location.params.sortOrder}",
        "search": "{$location.params.search}",
        "filters": "{$location.params.filters}"
      }
    }
  ],
  "dataInit": [
    {
      "source": "{$location.params.search}",
      "target": "state.usersQuery.search"
    }
  ],
  "shortcuts": {
    "requestUsers": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/users-v2/query/users/execute",
              "method": "POST",
              "target": "state.users",
              "data": {
                "event": "{$event}",
                "first": "{$state.users.first}",
                "rows": "{$state.users.rows}",
                "sortField": "{$state.usersQuery.sortField}",
                "sortOrder": "{$state.usersQuery.sortOrder}",
                "search": "{$state.usersQuery.search}",
                "filters": "{$state.report.filters}"
              },
              "format": {
                "$ref": "../../system/list-request-format.json"
              }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.users.first}",
                "rows": "{$state.users.rows}",
                "sortField": "{$state.usersQuery.sortField}",
                "sortOrder": "{$state.usersQuery.sortOrder}",
                "search": "{$state.usersQuery.search}",
                "filters": "{$state.report.filters}"
              },
              "format": [
                {
                  "prop": "filters",
                  "type": "PopIfHasNullProps",
                  "params": {
                    "props": [
                      "value"
                    ]
                  }
                },
                {
                  "prop": "filters",
                  "type": "RemoveProps",
                  "params": {
                    "props": [
                      "name",
                      "type",
                      "opts"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "usersHeader",
      "type": "section",
      "blocks": [
        {
          "id": "usersTitle",
          "type": "block",
          "className": "w-full flex gap-3 align-items-center",
          "components": [
            {
              "id": "usersPageTitle",
              "type": "component",
              "componentType": "Text",
              "className": "w-full",
              "props": {
                "value": "Список участников",
                "level": 1
              }
            },
            {
              "id": "usersRefreshButton",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-refresh",
                "rounded": true,
                "text": true,
                "severity": "secondary",
                "size": "small",
                "aria-label": "Обновить",
                "tooltip": "Обновить",
                "tooltipOptions": {
                  "position": "left"
                }
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "refresh",
                      "params": {}
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "usersFilters",
      "type": "section",
      "className": "flex flex-column gap-3 mb-3",
      "blocks": [
        {
          "id": "usersSearchBlock",
          "type": "block",
          "className": "w-full flex gap-3",
          "components": [
            {
              "id": "usersSearchInput",
              "type": "component",
              "className": "w-full p-inputtext-sm mb-0",
              "componentType": "InputTextWithThrottle",
              "props": {
                "placeholder": "Быстрый поиск...",
                "throttleDelay": 500,
                "value": "@state.usersQuery.search"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.usersQuery.search"
                      }
                    },
                    "requestUsers"
                  ]
                }
              ]
            },
            {
              "id": "usersToggleFilters",
              "type": "component",
              "componentType": "Button",
              "className": "min-w-max flex-grow-0 px-3",
              "props": {
                "icon": "pi pi-filter",
                "severity": "primary",
                "outlined": true,
                "size": "small",
                "label": "Фильтры"
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "usersActiveFilterBlock",
          "type": "block",
          "wrapper": {
            "className": "w-full"
          },
          "components": [
            {
              "id": "usersActiveFilterChips",
              "type": "component",
              "componentType": "ActiveFiltersBar",
              "props": {
                "value": "@state.report.filters"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.report.filters"
                      }
                    },
                    "requestUsers"
                  ]
                }
              ]
            },
            {
              "id": "usersFilterDrawer",
              "type": "component",
              "componentType": "FiltersPanel",
              "props": {
                "value": "@state.report.filters",
                "visible": "@state.filtersVisible",
                "position": "right",
                "header": "Фильтры"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.report.filters"
                      }
                    },
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    },
                    "requestUsers"
                  ]
                },
                {
                  "type": "onHide",
                  "commands": [
                    {
                      "type": "toggleProperty",
                      "params": {
                        "target": "state.filtersVisible"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "usersTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "usersTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "usersTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.users.value",
                "columns": "@state.report.columns",
                "totalRecords": "@state.users.totalRecords",
                "rows": "@state.users.rows",
                "first": "@state.users.first",
                "sortField": "@state.usersQuery.sortField",
                "sortOrder": "@state.usersQuery.sortOrder",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [
                  5,
                  10,
                  25,
                  50
                ],
                "customColumns": [
                  {
                    "field": "user",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-user",
                          "link": true,
                          "size": "small"
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/users/{#row.user_id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "field": "mailing",
                    "body": [
                      {
                        "componentType": "Button",
                        "className": "pointer-events-none -m-2",
                        "visibleRow": "{#row.mailing_icon}",
                        "props": {
                          "icon": "{#row.mailing_icon}",
                          "severity": "{#row.mailing_severity}",
                          "text": true,
                          "rounded": true,
                          "size": "large"
                        }
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": [
                    "requestUsers"
                  ]
                },
                {
                  "type": "onSort",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.sortField",
                        "target": "state.usersQuery.sortField"
                      }
                    },
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.sortOrder",
                        "target": "state.usersQuery.sortOrder"
                      }
                    },
                    "requestUsers"
                  ]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/users/{$event.data.user_id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
