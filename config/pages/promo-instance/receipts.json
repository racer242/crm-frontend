{
  "id": "receipts",
  "type": "page",
  "route": "/ops/receipts",
  "state": {
    "loading": false,
    "initialized": true,
    "search": "",
    "status": "",
    "fns_status": "",
    "moderationStatuses": [
      { "label": "На проверке", "value": "CHECKING" },
      { "label": "Принят", "value": "ACCEPTED" },
      { "label": "Отклонён", "value": "REFUSED" },
      { "label": "Отложен", "value": "SUSPENDED" },
      { "label": "Требуется загрузка фото", "value": "NEED_PHOTO" },
      { "label": "Ручная загрузка", "value": "HAND_LOAD" }
    ],
    "fnsStatuses": [
      { "label": "Не проверен", "value": "no_check" },
      { "label": "Ожидает ФНС", "value": "wait" },
      { "label": "Не найден в ФНС", "value": "wrong" },
      { "label": "Чек корректный", "value": "correct" }
    ],
    "receipts": {
      "value": [],
      "columns": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    }
  },
  "meta": {
    "title": "Чеки — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/receipts",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}",
        "search": "{$location.params.search}",
        "status": "{$location.params.status}",
        "fns_status": "{$location.params.fns_status}"
      },
      "method": "GET",
      "target": "state.receipts"
    }
  ],
  "dataInit": [
    {
      "source": "{$location.params.search}",
      "target": "state.search"
    },
    {
      "source": "{$location.params.status}",
      "target": "state.status"
    },
    {
      "source": "{$location.params.fns_status}",
      "target": "state.fns_status"
    }
  ],
  "shortcuts": {
    "requestReceipts": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/receipts",
              "method": "GET",
              "target": "state.receipts",
              "data": {
                "event": "{$event}",
                "first": "{$state.receipts.first}",
                "rows": "{$state.receipts.rows}",
                "search": "{$state.search}",
                "status": "{$state.status}",
                "fns_status": "{$state.fns_status}"
              },
              "format": { "$ref": "../../system/list-request-format.json" }
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.receipts.first}",
                "rows": "{$state.receipts.rows}",
                "search": "{$state.search}",
                "status": "{$state.status}",
                "fns_status": "{$state.fns_status}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "receiptsHeader",
      "type": "section",
      "className": "flex align-items-center justify-content-between",
      "blocks": [
        {
          "id": "receiptsTitle",
          "type": "block",
          "components": [
            {
              "id": "receiptsPageTitle",
              "type": "component",
              "componentType": "Text",
              "props": {
                "value": "Чеки",
                "level": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "receiptsFilters",
      "type": "section",
      "className": "flex flex-column gap-3 mb-3",
      "blocks": [
        {
          "id": "receiptsSearchBlock",
          "type": "block",
          "className": "w-full flex gap-3",
          "components": [
            {
              "id": "receiptsSearchInput",
              "type": "component",
              "className": "w-full p-inputtext-sm mb-0",
              "componentType": "InputTextWithThrottle",
              "props": {
                "placeholder": "Быстрый поиск...",
                "throttleDelay": 500,
                "value": "@state.search"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.search"
                      }
                    },
                    "requestReceipts"
                  ]
                }
              ]
            },
            {
              "id": "receiptsStatusFilter",
              "type": "component",
              "componentType": "Dropdown",
              "className": "min-w-max flex-grow-0 mb-0",
              "props": {
                "options": "@state.moderationStatuses",
                "value": "@state.status",
                "optionLabel": "label",
                "optionValue": "value",
                "placeholder": "Статус модерации...",
                "showClear": true,
                "inline": "yes"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.status"
                      }
                    },
                    "requestReceipts"
                  ]
                }
              ]
            },
            {
              "id": "receiptsFnsStatusFilter",
              "type": "component",
              "componentType": "Dropdown",
              "className": "min-w-max flex-grow-0 mb-0",
              "props": {
                "options": "@state.fnsStatuses",
                "value": "@state.fns_status",
                "optionLabel": "label",
                "optionValue": "value",
                "placeholder": "Статус ФНС...",
                "showClear": true,
                "inline": "yes"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.fns_status"
                      }
                    },
                    "requestReceipts"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "receiptsTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "receiptsTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "receiptsTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.receipts.value",
                "columns": "@state.receipts.columns",
                "totalRecords": "@state.receipts.totalRecords",
                "rows": "@state.receipts.rows",
                "first": "@state.receipts.first",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [5, 10, 25, 50],
                "customColumns": [
                  {
                    "field": "user",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-user",
                          "link": true,
                          "size": "small"
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/users/{#row.user_id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "field": "button",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-arrow-right",
                          "link": true,
                          "size": "small",
                          "pt": { "label": { "className": "font-normal" } }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/receipts/{#row.id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": ["requestReceipts"]
                },
                {
                  "type": "onSort",
                  "commands": ["requestReceipts"]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/ops/receipts/{$event.data.id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}