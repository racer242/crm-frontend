{
  "id": "receipt",
  "type": "page",
  "route": "/ops/receipts/[receipt_id]",
  "state": {
    "loading": false,
    "initialized": true,
    "saving": false,
    "saved": false,
    "sentSuccessfully": false,
    "saveResult": null,
    "receiptData": {
      "id": "",
      "receipt_id": "",
      "user_id": "",
      "status": "",
      "status_label": "",
      "status_severity": "secondary",
      "fn": "",
      "fp": "",
      "fd": "",
      "sum": "",
      "sum_label": "",
      "date": "",
      "date_formatted": "",
      "registered_at": "",
      "registered_at_formatted": "",
      "photos": [],
      "photos_count": 0,
      "photos_label": "",
      "decline_reason": ""
    },
    "products": {
      "value": [],
      "columns": [],
      "totalRecords": 0
    },
    "receiptStatuses": [
      {
        "label": "На проверке",
        "value": "CHECKING"
      },
      {
        "label": "Принят",
        "value": "ACCEPTED"
      },
      {
        "label": "Отклонён",
        "value": "REFUSED"
      },
      {
        "label": "Приостановлен",
        "value": "SUSPENDED"
      },
      {
        "label": "Требуется фото",
        "value": "NEED_PHOTO"
      }
    ]
  },
  "meta": {
    "title": "Чек — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/receipts/{$location.routeParams.receipt_id}",
      "method": "GET",
      "target": "state.receiptData"
    },
    {
      "url": "/api/ops/receipts/{$location.routeParams.receipt_id}/products",
      "method": "GET",
      "target": "state.products"
    }
  ],
  "shortcuts": {
    "deleteReceipt": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.saveResult",
              "value": null
            }
          },
          {
            "type": "confirm",
            "params": {
              "message": "Вы уверены, что хотите удалить этот чек?",
              "onConfirm": [
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/ops/receipts/{$location.routeParams.receipt_id}",
                    "method": "DELETE",
                    "target": "state.saveResult",
                    "onSuccess": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "success",
                          "summary": "Успешно",
                          "message": "Чек удален"
                        }
                      },
                      {
                        "type": "navigate",
                        "params": {
                          "url": "/ops/receipts"
                        }
                      }
                    ],
                    "onError": [
                      {
                        "type": "showToast",
                        "params": {
                          "severity": "error",
                          "summary": "Ошибка",
                          "message": "Не удалось удалить чек"
                        }
                      }
                    ]
                  }
                }
              ],
              "onCancel": []
            }
          }
        ]
      }
    },
    "reloadReceipt": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/receipts/{$location.routeParams.receipt_id}",
              "method": "GET",
              "target": "state.receiptData"
            }
          }
        ]
      }
    },
    "saveReceipt": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "setProperty",
            "params": {
              "target": "state.saving",
              "value": true
            }
          },
          {
            "type": "setProperty",
            "params": {
              "target": "state.saveResult",
              "value": null
            }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/receipts/{$location.routeParams.receipt_id}",
              "method": "PATCH",
              "target": "state.saveResult",
              "data": {
                "status": "{$state.receiptData.status}",
                "decline_reason": "{$state.receiptData.decline_reason}"
              },
              "onSuccess": [
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saving",
                    "value": false
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saved",
                    "value": true
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.sentSuccessfully",
                    "value": true
                  }
                },
                {
                  "type": "sendRequest",
                  "params": {
                    "url": "/api/ops/receipts/{$location.routeParams.receipt_id}",
                    "method": "GET",
                    "target": "state.receiptData"
                  }
                }
              ],
              "onError": [
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.saving",
                    "value": false
                  }
                },
                {
                  "type": "setProperty",
                  "params": {
                    "target": "state.sentSuccessfully",
                    "value": false
                  }
                },
                {
                  "type": "showToast",
                  "params": {
                    "severity": "error",
                    "summary": "Ошибка",
                    "message": "Не удалось сохранить данные чека"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "breadcrumbSection",
      "type": "section",
      "className": "",
      "blocks": [
        {
          "id": "breadcrumbBlock",
          "type": "block",
          "components": [
            {
              "id": "breadcrumb",
              "type": "component",
              "componentType": "Breadcrumb",
              "className": "border-none p-0",
              "props": {
                "home": {
                  "icon": "pi pi-home",
                  "url": "/"
                },
                "model": [
                  {
                    "label": "Чеки",
                    "route": "/ops/receipts"
                  },
                  {
                    "label": "@state.receiptData.id"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "mainLayout",
      "type": "section",
      "className": "flex mb-5",
      "grid": {
        "cols": [
          "col-12 lg:col-8",
          "col-12 lg:col-4"
        ],
        "padding": "p-2"
      },
      "blocks": [
        {
          "id": "receiptDetailsBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Информация о чеке"
            }
          },
          "className": "flex flex-column gap-3",
          "components": [
            {
              "id": "receiptIdGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ID чека",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptIdText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": {
                      "wordBreak": "break-all"
                    },
                    "props": {
                      "value": "@state.receiptData.receipt_id"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptStatusGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Статус",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptStatusTag",
                    "type": "component",
                    "componentType": "Tag",
                    "props": {
                      "value": "@state.receiptData.status_label",
                      "severity": "@state.receiptData.status_severity"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptSumGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Сумма",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptSumText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.sum_label"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptRegisteredGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "Зарегистрирован",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptRegisteredText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "props": {
                      "value": "@state.receiptData.registered_at_formatted"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptFnGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФН",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFnText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": {
                      "wordBreak": "break-all"
                    },
                    "props": {
                      "value": "@state.receiptData.fn"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptFdGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФД",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFdText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": {
                      "wordBreak": "break-all"
                    },
                    "props": {
                      "value": "@state.receiptData.fd"
                    }
                  }
                ]
              }
            },
            {
              "id": "receiptFpGroup",
              "type": "component",
              "componentType": "LabelledGroup",
              "className": "w-full grid align-items-center mb-2",
              "props": {
                "label": "ФП",
                "labelClassName": "text-sm col-4 text-right",
                "containerClassName": "col-8",
                "components": [
                  {
                    "id": "receiptFpText",
                    "type": "component",
                    "componentType": "Text",
                    "className": "m-0 font-bold text-lg",
                    "style": {
                      "wordBreak": "break-all"
                    },
                    "props": {
                      "value": "@state.receiptData.fp"
                    }
                  }
                ]
              }
            },
            {
              "id": "photosTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.receiptData.photos",
                "columns": [
                  {
                    "field": "n",
                    "header": "№",
                    "width": "4rem"
                  }
                ],
                "customColumns": [
                  {
                    "field": "download",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-download",
                          "label": "Скачать",
                          "size": "small",
                          "severity": "secondary",
                          "outlined": true
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "downloadFile",
                                "params": {
                                  "url": "{#row.url}",
                                  "onError": [
                                    {
                                      "type": "showToast",
                                      "params": {
                                        "severity": "error",
                                        "summary": "Ошибка",
                                        "message": "Не удалось скачать фото чека"
                                      }
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ],
                "paginator": false,
                "size": "small",
                "emptyMessage": "Фото отсутствуют"
              },
              "className": "w-full"
            }
          ]
        },
        {
          "id": "rightColumnBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "rightColumnLayout",
              "type": "component",
              "componentType": "LayoutGroup",
              "className": "flex flex-column gap-3",
              "props": {
                "components": [
                  {
                    "id": "participantPanel",
                    "type": "component",
                    "componentType": "Panel",
                    "className": "w-full",
                    "props": {
                      "header": "Участник",
                      "components": [
                        {
                          "id": "participantGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "w-full grid align-items-center mb-2",
                          "props": {
                            "label": "ID участника",
                            "labelClassName": "text-sm col-4 text-right",
                            "containerClassName": "col-8",
                            "components": [
                              {
                                "id": "participantLink",
                                "type": "component",
                                "componentType": "Text",
                                "className": "m-0 font-bold text-lg text-primary",
                                "style": {
                                  "wordBreak": "break-all"
                                },
                                "props": {
                                  "value": "@state.receiptData.user_id"
                                },
                                "events": [
                                  {
                                    "type": "onClick",
                                    "commands": [
                                      {
                                        "type": "navigate",
                                        "params": {
                                          "url": "/ops/users/{@state.receiptData.user_id}"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "id": "moderationPanel",
                    "type": "component",
                    "componentType": "Panel",
                    "className": "w-full",
                    "props": {
                      "header": "Модерация",
                      "components": [
                        {
                          "id": "statusGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "flex flex-column gap-1 mb-2",
                          "props": {
                            "label": "Статус",
                            "labelClassName": "font-bold text-sm",
                            "components": [
                              {
                                "id": "statusDropdown",
                                "type": "component",
                                "componentType": "Dropdown",
                                "props": {
                                  "options": "@state.receiptStatuses",
                                  "value": "@state.receiptData.status",
                                  "optionLabel": "label",
                                  "optionValue": "value",
                                  "placeholder": "Выберите статус",
                                  "className": "w-full"
                                },
                                "events": [
                                  {
                                    "type": "onChange",
                                    "commands": [
                                      {
                                        "type": "setProperty",
                                        "params": {
                                          "source": "event.value",
                                          "target": "state.receiptData.status"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "id": "declineReasonGroup",
                          "type": "component",
                          "componentType": "LabelledGroup",
                          "className": "flex flex-column gap-1 mb-2",
                          "props": {
                            "label": "Причина отклонения",
                            "labelClassName": "font-bold text-sm",
                            "components": [
                              {
                                "id": "declineReasonInput",
                                "type": "component",
                                "componentType": "InputTextarea",
                                "props": {
                                  "value": "@state.receiptData.decline_reason",
                                  "rows": 3,
                                  "autoResize": true,
                                  "className": "w-full",
                                  "placeholder": "Указывается при отклонении чека"
                                },
                                "events": [
                                  {
                                    "type": "onChange",
                                    "commands": [
                                      {
                                        "type": "setProperty",
                                        "params": {
                                          "source": "event.value",
                                          "target": "state.receiptData.decline_reason"
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "id": "btnApply",
                          "type": "component",
                          "componentType": "Button",
                          "props": {
                            "label": "Применить",
                            "icon": "pi pi-check",
                            "severity": "success",
                            "disabled": "@state.saving",
                            "outlined": true
                          },
                          "events": [
                            {
                              "type": "onClick",
                              "commands": [
                                "saveReceipt",
                                {
                                  "type": "showToast",
                                  "params": {
                                    "severity": "success",
                                    "summary": "Успешно",
                                    "message": "Данные чека сохранены",
                                    "condition": "{$state.sentSuccessfully}"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "productsSection",
      "type": "section",
      "className": "mb-5",
      "blocks": [
        {
          "id": "productsBlock",
          "type": "block",
          "wrapper": {
            "component": "Panel",
            "props": {
              "header": "Продукция в чеке"
            }
          },
          "components": [
            {
              "id": "productsTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.products.value",
                "columns": "@state.products.columns",
                "totalRecords": "@state.products.totalRecords",
                "paginator": false,
                "size": "small",
                "emptyMessage": "Нет продукции в чеке"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "buttonsSection",
      "type": "section",
      "className": "flex justify-content-center",
      "blocks": [
        {
          "id": "buttonsBlock",
          "type": "block",
          "wrapper": {
            "showHeader": false,
            "component": "Panel",
            "props": {
              "className": "flex-grow-1",
              "pt": {
                "content": {
                  "style": {
                    "background": "var(--surface-50) !important"
                  }
                }
              }
            }
          },
          "className": "flex flex-wrap gap-3 justify-content-center md:justify-content-start",
          "components": [
            {
              "id": "btnDelete",
              "type": "component",
              "componentType": "Button",
              "props": {
                "icon": "pi pi-trash",
                "label": "Удалить",
                "size": "small",
                "severity": "danger",
                "outlined": true
              },
              "events": [
                {
                  "type": "onClick",
                  "commands": [
                    "deleteReceipt"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
