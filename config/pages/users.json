{
  "id": "opsUsersPage",
  "type": "page",
  "title": "Участники",
  "route": "/ops/users",
  "state": {
    "items": [],
    "pagination": {
      "page": 1,
      "limit": 20,
      "total_items": 0
    }
  },
  "sections": [
    {
      "id": "headerSection",
      "blocks": [
        {
          "id": "headerBlock",
          "components": [
            {
              "type": "Title",
              "text": "Управление участниками",
              "level": 2
            }
          ]
        }
      ]
    },
    {
      "id": "tableSection",
      "dataFeed": [
        {
          "method": "GET",
          "url": "/api/ops/users?page={$state.opsUsersPage.state.pagination.page}&limit={$state.opsUsersPage.state.pagination.limit}",
          "target": "state.items",
          "adapter": "extractPaginationItems"
        }
      ],
      "blocks": [
        {
          "id": "tableBlock",
          "components": [
            {
              "type": "DataTable",
              "value": "@opsUsersPage.state.items",
              "columns": [
                { "field": "id", "header": "ID", "width": "10rem" },
                { "field": "name", "header": "Имя", "width": "15rem" },
                { "field": "phone", "header": "Телефон" },
                { "field": "status", "header": "Статус", "width": "8rem" }
              ],
              "paginator": true,
              "rows": "{$state.opsUsersPage.state.pagination.limit}",
              "totalRecords": "{$state.opsUsersPage.state.pagination.total_items}",
              "lazy": true,
              "events": [
                {
                  "type": "onPage",
                  "commands": [
                    {
                      "type": "setStateField",
                      "params": {
                        "target": "opsUsersPage.state.pagination.page",
                        "value": "{$event.page + 1}"
                      }
                    },
                    { "type": "refresh" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}