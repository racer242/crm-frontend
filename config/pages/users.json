{
  "id": "opsUsersPage",
  "type": "page",
  "route": "/ops/users",
  "state": {
    "loading": false,
    "initialized": true,
    "search": "",
    "users": {
      "value": [],
      "columns": [],
      "totalRecords": 10,
      "rows": 10,
      "first": 0
    }
  },
  "meta": {
    "title": "Участники — CRM Platform"
  },
  "dataFeed": [
    {
      "url": "/api/ops/users",
      "data": {
        "first": "{$location.params.first}",
        "rows": "{$location.params.rows}",
        "search": "{$location.params.search}"
      },
      "method": "GET",
      "target": "state.users"
    }
  ],
  "events": [
    {
      "type": "onLoad",
      "commands": [
        {
          "type": "log",
          "params": {
            "message": {
              "event": "{$event}",
              "data": "{$location.params.search}"
            }
          }
        },
        {
          "type": "setProperty",
          "params": {
            "source": "{$location.params.search}",
            "target": "state.search"
          }
        }
      ]
    }
  ],
  "shortcuts": {
    "requestUsers": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "log",
            "params": {
              "message": {
                "event": "{$event}",
                "data": "{$state.users}",
                "toSend": {
                  "event": "{$event}",
                  "first": "{$state.users.first}",
                  "rows": "{$state.users.rows}",
                  "search": "{$state.search}"
                }
              }
            }
          },
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/users",
              "method": "GET",
              "target": "state.users",
              "data": {
                "event": "{$event}",
                "first": "{$state.users.first}",
                "rows": "{$state.users.rows}",
                "search": "{$state.search}"
              },
              "format": { "$ref": "../system/list-request-format.json" },
              "onSuccess": [
                {
                  "type": "log",
                  "params": {
                    "message": {
                      "success": "{$event}"
                    }
                  }
                }
              ],
              "onError": [
                {
                  "type": "log",
                  "params": {
                    "message": {
                      "error": "{$event}"
                    }
                  }
                }
              ]
            }
          },
          {
            "type": "mergeUrlParams",
            "params": {
              "values": {
                "first": "{$state.users.first}",
                "rows": "{$state.users.rows}",
                "search": "{$state.search}"
              }
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "usersHeader",
      "type": "section",
      "className": "flex",
      "blocks": [
        {
          "id": "usersTitle",
          "type": "block",
          "components": [
            {
              "id": "usersPageTitle",
              "type": "component",
              "componentType": "Text",
              "props": {
                "value": "Участники",
                "level": 1
              }
            }
          ]
        }
      ]
    },
    {
      "id": "usersFilters",
      "type": "section",
      "className": "flex flex-column gap-3 mb-3",
      "blocks": [
        {
          "id": "searchBlock",
          "type": "block",
          "className": "w-full flex gap-3",
          "components": [
            {
              "id": "searchInput",
              "type": "component",
              "className": "w-full p-inputtext-sm mb-0",
              "componentType": "InputTextWithThrottle",
              "props": {
                "placeholder": "Быстрый поиск...",
                "throttleDelay": 500,
                "value": "@state.search"
              },
              "events": [
                {
                  "type": "onChange",
                  "commands": [
                    {
                      "type": "setProperty",
                      "params": {
                        "source": "event.value",
                        "target": "state.search"
                      }
                    },
                    "requestUsers"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "usersTableSection",
      "type": "section",
      "blocks": [
        {
          "id": "usersTableBlock",
          "type": "block",
          "className": "w-full",
          "components": [
            {
              "id": "usersTable",
              "type": "component",
              "componentType": "DataTable",
              "props": {
                "value": "@state.users.value",
                "columns": "@state.users.columns",
                "totalRecords": "@state.users.totalRecords",
                "rows": "@state.users.rows",
                "first": "@state.users.first",
                "paginator": true,
                "lazy": true,
                "size": "normal",
                "stripedRows": true,
                "selectionMode": "single",
                "rowsPerPageOptions": [5, 10, 25, 50],
                "customColumns": [
                  {
                    "field": "email",
                    "body": [
                      {
                        "id": "sendButton",
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-envelope",
                          "label": "{#field}",
                          "link": true,
                          "size": "small",
                          "pt": {
                            "label": { "className": "font-normal" },
                            "root": { "className": "p-1" }
                          }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "mailto:{#field}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "field": "button",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-arrow-right",
                          "link": true,
                          "size": "small",
                          "pt": { "label": { "className": "font-normal" } }
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/users/{#row.id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": ["requestUsers"]
                },
                {
                  "type": "onSort",
                  "commands": ["requestUsers"]
                },
                {
                  "type": "onRowClick",
                  "commands": [
                    {
                      "type": "log",
                      "params": {
                        "message": "{$event}"
                      }
                    },
                    {
                      "type": "navigate",
                      "params": {
                        "url": "/users/{$event.data.id}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
