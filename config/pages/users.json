{
  "id": "opsUsersPage",
  "type": "page",
  "route": "/ops/users",
  "state": {
    "loading": false,
    "initialized": true,
    "items": {
      "value": [],
      "totalRecords": 0,
      "rows": 10,
      "first": 0
    }
  },
  "shortcuts": {
    "requestUsers": {
      "type": "sequence",
      "params": {
        "commands": [
          {
            "type": "sendRequest",
            "params": {
              "url": "/api/ops/users",
              "method": "GET",
              "target": "state.items.value",
              "data": {
                "offset": "{$state.opsUsersPage.state.items.first}",
                "limit": "{$state.opsUsersPage.state.items.rows}"
              },
              "adapter": "extractPaginationItems"
            }
          }
        ]
      }
    }
  },
  "sections": [
    {
      "id": "mainSection",
      "blocks": [
        {
          "id": "usersTableBlock",
          "components": [
            {
              "id": "usersTable",
              "componentType": "DataTable",
              "props": {
                "value": "@opsUsersPage.state.items.value",
                "paginator": true,
                "lazy": true,
                "rows": "@opsUsersPage.state.items.rows",
                "totalRecords": "@opsUsersPage.state.items.totalRecords",
                "first": "@opsUsersPage.state.items.first",
                "columns": [
                  { "field": "id", "header": "ID", "width": "5rem" },
                  { "field": "fio", "header": "ФИО" },
                  { "field": "phone", "header": "Телефон" }
                ],
                "customColumns": [
                  {
                    "field": "details",
                    "order": -1,
                    "body": [
                      {
                        "componentType": "Button",
                        "props": {
                          "icon": "pi pi-eye",
                          "link": true,
                          "size": "small"
                        },
                        "events": [
                          {
                            "type": "onClick",
                            "commands": [
                              {
                                "type": "navigate",
                                "params": {
                                  "url": "/ops/users/{#row.id}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "events": [
                {
                  "type": "onPage",
                  "commands": [
                    {
                      "type": "setStateField",
                      "params": {
                        "target": "opsUsersPage.state.items.first",
                        "value": "{$event.first}"
                      }
                    },
                    {
                      "type": "setStateField",
                      "params": {
                        "target": "opsUsersPage.state.items.rows",
                        "value": "{$event.rows}"
                      }
                    },
                    "requestUsers"
                  ]
                },
                {
                  "type": "onLoad",
                  "commands": ["requestUsers"]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}