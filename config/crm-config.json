{
  "id": "crm",
  "type": "app",
  "title": "CRM Platform",
  "state": {},
  "navbar": { "$ref": "./menus/navbar.json" },
  "userMenu": {
    "loginLabel": "Войти",
    "items": [
      {
        "label": "Профиль",
        "icon": "pi pi-user",
        "route": "/profile"
      },
      {
        "separator": true
      },
      {
        "label": "Выйти",
        "icon": "pi pi-sign-out",
        "action": "logout"
      }
    ]
  },
  "pages": [
    { "$ref": "./pages/profile.json" },
    { "$ref": "./pages/users.json" },
    { "$ref": "./pages/user.json" },
    { "$ref": "./pages/user-edit.json" },
    { "$ref": "./pages/user-docs.json" },
    { "$ref": "./pages/user-docs-edit.json" },
    { "$ref": "./pages/user-acts.json" },
    { "$ref": "./pages/user-act.json" },
    { "$ref": "./pages/user-act-add.json" },
    { "$ref": "./pages/user-act-edit.json" },
    { "$ref": "./pages/user-prizes.json" },
    { "$ref": "./pages/user-prize.json" },
    { "$ref": "./pages/user-receipts.json" },
    { "$ref": "./pages/user-receipt.json" },
    { "$ref": "./pages/user-receipt-edit.json" },
    { "$ref": "./pages/user-products.json" },
    { "$ref": "./pages/user-messages.json" },
    { "$ref": "./pages/receipts.json" },
    { "$ref": "./pages/prizes.json" },
    { "$ref": "./pages/acts.json" },
    { "$ref": "./pages/tasks.json" },
    { "$ref": "./pages/messages.json" }
  ],
  "adapters": { "$ref": "./system/adapters.json" },
  "config": {
    "name": "CRM Platform",
    "version": "1.0.0",
    "indexPageId": "profile",
    "baseURL": "{$env.NEXT_PUBLIC_BASE_URL}",
    "timeout": 10000,
    "apiExchangeVersion": "0.0.0",
    "features": {
      "darkMode": true,
      "apiAccess": true,
      "exportData": true,
      "twoFactorAuth": false
    }
  },
  "camps": { "$ref": "./system/camps.json" },
  "apiRoutes": { "$ref": "./system/api-routes.json" }
