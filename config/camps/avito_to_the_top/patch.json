{
  "adapters": {
    "stats.users.execute.request": {
      "type": "js",
      "script": "./config/adapters/stats.users.execute.request.avito.js"
    },
    "stats.users.report.response": {
      "type": "js",
      "script": "./config/adapters/stats.users.report.response.avito.js"
    },
    "dictionaries.response.avito": {
      "type": "js",
      "script": "./config/adapters/dictionaries.response.avito.js"
    }
  },
  "apiRoutes": [
    {
      "path": "ops/dictionaries/[name]",
      "need_to_remove": true
    },
    {
      "path": "ops/dictionaries/dict_categories",
      "method": "GET",
      "url": "/api/v1/crm/dictionaries/dict_categories",
      "channel": "instance",
      "adapter": {
        "response": "dictionaries.response.avito"
      },
      "note": "Авито: справочник категорий для фильтра «Категория» — статический путь (матчится раньше общего ops/dictionaries/[name], перенесённого в конец) + адаптер с пунктом «Не назначено» (AVITO_UNASSIGNED_CODE)"
    },
    {
      "path": "ops/dictionaries/dict_leagues",
      "method": "GET",
      "url": "/api/v1/crm/dictionaries/dict_leagues",
      "channel": "instance",
      "adapter": {
        "response": "dictionaries.response.avito"
      },
      "note": "Авито: справочник лиг для фильтра «Лига» — статический путь (матчится раньше общего ops/dictionaries/[name], перенесённого в конец) + адаптер с пунктом «Не назначено» (AVITO_UNASSIGNED_CODE)"
    },
    {
      "path": "ops/dictionaries/[name]",
      "method": "GET",
      "url": "/api/v1/crm/dictionaries/{$location.routeParams.name}",
      "channel": "instance",
      "adapter": {
        "response": "dictionaries.response"
      },
      "note": "Операционные данные: Записи справочника (§3.6.3; feedback_topics для фильтра сообщений). Авито: перенесён в конец — роутер берёт первый совпавший маршрут, статические dict_categories/dict_leagues должны быть раньше"
    }
  ],
  "pages": [
    {
      "id": "users",
      "state": {
        "usersQuery": {
          "category": "",
          "league": ""
        },
        "avitoCategories": {
          "options": []
        },
        "avitoLeagues": {
          "options": []
        }
      },
      "dataFeed": [
        {
          "url": "/api/ops/dictionaries/dict_categories",
          "method": "GET",
          "target": "state.avitoCategories"
        },
        {
          "url": "/api/ops/dictionaries/dict_leagues",
          "method": "GET",
          "target": "state.avitoLeagues"
        },
        {
          "url": "/api/ops/users-v2/query/users/execute",
          "data": {
            "category": "{$location.params.category}",
            "league": "{$location.params.league}"
          }
        }
      ],
      "dataInit": [
        {
          "source": "{$location.params.search}",
          "target": "state.usersQuery.search"
        },
        {
          "source": "{$location.params.sortField}",
          "target": "state.usersQuery.sortField"
        },
        {
          "source": "{$location.params.sortOrder}",
          "target": "state.usersQuery.sortOrder",
          "parse": "json"
        },
        {
          "source": "{$location.params.filters}",
          "target": "state.report.filters",
          "parse": "json",
          "priority": "feed",
          "method": "merge"
        },
        {
          "source": "{$location.params.category}",
          "target": "state.usersQuery.category"
        },
        {
          "source": "{$location.params.league}",
          "target": "state.usersQuery.league"
        }
      ],
      "shortcuts": {
        "requestUsers": {
          "type": "sequence",
          "params": {
            "commands": [
              {
                "type": "sendRequest",
                "params": {
                  "url": "/api/ops/users-v2/query/users/execute",
                  "method": "POST",
                  "target": "state.users",
                  "data": {
                    "event": "{$event}",
                    "first": "{$state.users.first}",
                    "rows": "{$state.users.rows}",
                    "sortField": "{$state.usersQuery.sortField}",
                    "sortOrder": "{$state.usersQuery.sortOrder}",
                    "search": "{$state.usersQuery.search}",
                    "filters": "{$state.report.filters}",
                    "category": "{$state.usersQuery.category}",
                    "league": "{$state.usersQuery.league}"
                  },
                  "format": {
                    "$ref": "../../system/list-request-format.json"
                  }
                }
              },
              {
                "type": "mergeUrlParams",
                "params": {
                  "values": {
                    "first": "{$state.users.first}",
                    "rows": "{$state.users.rows}",
                    "sortField": "{$state.usersQuery.sortField}",
                    "sortOrder": "{$state.usersQuery.sortOrder}",
                    "search": "{$state.usersQuery.search}",
                    "filters": "{$state.report.filters}",
                    "category": "{$state.usersQuery.category}",
                    "league": "{$state.usersQuery.league}"
                  },
                  "format": [
                    {
                      "prop": "filters",
                      "type": "PopIfHasNullProps",
                      "params": {
                        "props": ["value"]
                      }
                    },
                    {
                      "prop": "filters",
                      "type": "RemoveProps",
                      "params": {
                        "props": ["name", "type", "opts"]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "sections": [
        {
          "id": "usersFilters",
          "blocks": [
            {
              "id": "usersSearchBlock",
              "components": [
                {
                  "id": "usersToggleFilters",
                  "need_to_remove": true
                },
                {
                  "id": "usersCategoryFilter",
                  "type": "component",
                  "componentType": "Dropdown",
                  "className": "min-w-max flex-grow-0 mb-0",
                  "props": {
                    "options": "@state.avitoCategories.options",
                    "value": "@state.usersQuery.category",
                    "optionLabel": "label",
                    "optionValue": "value",
                    "placeholder": "Категория...",
                    "showClear": true,
                    "inline": "yes"
                  },
                  "events": [
                    {
                      "type": "onChange",
                      "commands": [
                        {
                          "type": "setProperty",
                          "params": {
                            "source": "event.value",
                            "target": "state.usersQuery.category"
                          }
                        },
                        "requestUsers"
                      ]
                    }
                  ]
                },
                {
                  "id": "usersLeagueFilter",
                  "type": "component",
                  "componentType": "Dropdown",
                  "className": "min-w-max flex-grow-0 mb-0",
                  "props": {
                    "options": "@state.avitoLeagues.options",
                    "value": "@state.usersQuery.league",
                    "optionLabel": "label",
                    "optionValue": "value",
                    "placeholder": "Лига...",
                    "showClear": true,
                    "inline": "yes"
                  },
                  "events": [
                    {
                      "type": "onChange",
                      "commands": [
                        {
                          "type": "setProperty",
                          "params": {
                            "source": "event.value",
                            "target": "state.usersQuery.league"
                          }
                        },
                        "requestUsers"
                      ]
                    }
                  ]
                },
                {
                  "id": "usersToggleFilters",
                  "type": "component",
                  "componentType": "Button",
                  "className": "min-w-max flex-grow-0 px-3",
                  "props": {
                    "icon": "pi pi-filter",
                    "severity": "primary",
                    "outlined": true,
                    "size": "small",
                    "label": "Фильтры"
                  },
                  "events": [
                    {
                      "type": "onClick",
                      "commands": [
                        {
                          "type": "toggleProperty",
                          "params": {
                            "target": "state.filtersVisible"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "usersTableSection",
          "blocks": [
            {
              "id": "usersTableBlock",
              "components": [
                {
                  "id": "usersTable",
                  "props": {
                    "customColumns": [
                      {
                        "field": "mailing",
                        "need_to_remove": true
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
